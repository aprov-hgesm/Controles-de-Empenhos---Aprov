# Firebase Authentication Web SDK — dados PUBLICOS do app Web do projeto cozinha-dietetica.
# Nunca coloque aqui JSON de service account, private_key ou tokens IAM.
VITE_HOSPITAL_FIREBASE_API_KEY=
VITE_HOSPITAL_FIREBASE_APP_ID=
VITE_HOSPITAL_FIREBASE_PROJECT_ID=cozinha-dietetica
# Opcional: ID do hospital configurado pelo administrador; nao precisa ter prefixo qa_.
VITE_HOSPITAL_ORGANIZATION_ID=
