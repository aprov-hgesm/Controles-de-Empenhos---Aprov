    function validWarehouseInventoryItemCreate(workspaceId, inventoryId, itemId) {
      let s = /databases/$(database)/documents/warehouse/$(workspaceId)/inventories/$(inventoryId);
      return request.resource.data.schemaVersion == 'warehouse_inventory_item_v1'
        && request.resource.data.id == itemId
        && itemId.matches('^invit_[a-f0-9]{64}$')
        && request.resource.data.inventoryId == inventoryId
