          'schemaVersion', 'id', 'workspaceId', 'ug', 'invoiceRecordKey',
          'invoiceId', 'empenhoId', 'itemId', 'materialId', 'description',
          'unitLabel', 'quantity', 'mode', 'position', 'lotId', 'lotCode',
