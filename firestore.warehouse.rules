        && request.resource.data.schemaVersion == 'warehouse_item_intake_v2'
        && request.resource.data.id == intakeId
        && intakeId.matches('^intake_[a-f0-9]{64}$')
        && request.resource.data.workspaceId == workspaceId
        && warehouseUgMatchesAccess(workspaceId, request.resource.data.ug)
        && request.resource.data.invoiceRecordKey is string
        && request.resource.data.invoiceRecordKey.size() > 0
        && request.resource.data.invoiceRecordKey.size() <= 180
        && request.resource.data.invoiceId is string
        && request.resource.data.invoiceId.size() > 0
        && request.resource.data.invoiceId.size() <= 120
        && request.resource.data.empenhoId is string
        && request.resource.data.empenhoId.size() > 0
        && request.resource.data.empenhoId.size() <= 120
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.itemId.size() <= 120
        && request.resource.data.materialId == null
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240
        && request.resource.data.unitLabel is string
        && request.resource.data.unitLabel.size() > 0
        && request.resource.data.unitLabel.size() <= 80
        && request.resource.data.supplier is string
        && request.resource.data.supplier.size() > 0
        && request.resource.data.supplier.size() <= 240
        && request.resource.data.receivedQuantity is number
        && request.resource.data.receivedQuantity > 0
        && request.resource.data.receivedQuantity <= 1000000000
        && request.resource.data.allocatedQuantity == 0
        && request.resource.data.immediateConsumptionQuantity == request.resource.data.receivedQuantity
        && request.resource.data.pendingQuantity == 0
        && request.resource.data.status == 'PROCESSED'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validWarehouseItemIntakeV2Create(workspaceId, intakeId) {
      return validWarehouseItemIntakeV2Base(workspaceId, intakeId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && warehouseItemIntakeV2MaterialMatches(workspaceId);
    }

    function validWarehouseItemIntakeV2Update(workspaceId, intakeId) {
      return validWarehouseItemIntakeV2Base(workspaceId, intakeId)
        && resource.data.schemaVersion == 'warehouse_item_intake_v2'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'materialId', 'allocatedQuantity', 'immediateConsumptionQuantity',
          'pendingQuantity', 'status', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.allocatedQuantity >= resource.data.allocatedQuantity
        && request.resource.data.immediateConsumptionQuantity >= resource.data.immediateConsumptionQuantity
        && (
          request.resource.data.materialId == resource.data.materialId
          || (
            resource.data.materialId == null
            && request.resource.data.materialId is string
          )
        )
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && warehouseItemIntakeV2MaterialMatches(workspaceId);
    }

      allow read, write: if canAccessWarehouseModule(workspaceId);

      // FASE 1 / DEP-1 + DEP-1.1 — material canônico.
      match /materials/{materialId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create, update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseMaterialDocument(workspaceId, materialId);
        allow delete: if false;
      }

      // FASE 6 / DEP-8..9 — depósitos e localizações têm identidade
      // estável; referências operacionais nunca são apagadas fisicamente.
      match /depots/{depotId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseDepotCreate(workspaceId, depotId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseDepotUpdate(workspaceId, depotId);
        allow delete: if false;
      }

      match /locations/{locationId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseLocationCreate(workspaceId, locationId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseLocationUpdate(workspaceId, locationId);
        allow delete: if false;
      }

      // FASE 2 / DEP-2 — ledger imutável. Toda criação precisa materializar
      // a mesma alteração no saldo na operação atômica.
      match /movements/{movementId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && warehouseMovementCreateAllowed(workspaceId, movementId);
        allow update, delete: if false;
      }

      // FASE 2 / DEP-2.1 — saldo derivado do ledger. Escrita avulsa é negada.
      match /balances/{materialId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create, update: if canAccessWarehouseModule(workspaceId)
          && warehouseBalanceWriteAllowed(workspaceId, materialId);
        allow delete: if false;
      }

      // FASE 6 / DEP-10 — distribuição física é uma projeção do ledger.
      match /locationBalances/{locationBalanceId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create, update: if canAccessWarehouseModule(workspaceId)
          && warehouseLocationBalanceWriteAllowed(workspaceId, locationBalanceId);
        allow delete: if false;
      }

      // FASE 7 / DEP-11..15 — lote é enriquecimento logístico; não escreve saldos.
      match /lots/{lotId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseLotCreate(workspaceId, lotId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseLotUpdate(workspaceId, lotId);
        allow delete: if false;
      }

      // FASE 8 / DEP-13 — barcode é associação auxiliar, nunca saldo/material.
      match /barcodes/{barcodeId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseBarcodeCreate(workspaceId, barcodeId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseBarcodeUpdate(workspaceId, barcodeId);
        allow delete: if false;
      }


      // FASE 9 / DEP-17..19.5 — layout visual versionado.
      match /layouts/{layoutId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseDepotLayoutCreate(workspaceId, layoutId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseDepotLayoutArchive(workspaceId, layoutId);
        allow delete: if false;
      }

      // FASE 10 — inventário físico: contagem separada e ajuste somente após confirmação.
      match /inventories/{inventoryId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseInventorySessionCreate(workspaceId, inventoryId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseInventorySessionUpdate(workspaceId, inventoryId);
        allow delete: if false;

        match /items/{itemId} {
          allow read: if canAccessWarehouseModule(workspaceId);
          allow create: if canAccessWarehouseModule(workspaceId)
            && validWarehouseInventoryItemCreate(workspaceId, inventoryId, itemId);
          allow update: if canAccessWarehouseModule(workspaceId)
            && (
              validWarehouseInventoryCountUpdate(workspaceId, inventoryId)
              || validWarehouseInventoryAdjustmentUpdate(workspaceId, inventoryId, itemId)
              || validWarehouseInventoryStaleUpdate(workspaceId, inventoryId, itemId)
            );
          allow delete: if false;
        }
      }

      // FASE 4 / DEP-4 — cutoff imutável de ativação do fluxo NF → estoque.
      // FASE 5 / DEP-5.x — snapshots são privados, bounded e não podem ser apagados.
      match /siscofisSnapshots/{snapshotId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseSiscofisSnapshotCreate(workspaceId, snapshotId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseSiscofisSnapshotUpdate(workspaceId, snapshotId);
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && (
            validWarehouseInvoiceIntegrationSettings(workspaceId, settingId)
            || validWarehouseLogisticsSettings(workspaceId, settingId)
            || validWarehouseLandingVisualSettings(workspaceId, settingId)
          );
        allow update: if canAccessWarehouseModule(workspaceId)
          && (
            validWarehouseLogisticsSettings(workspaceId, settingId)
            || validWarehouseLandingVisualSettings(workspaceId, settingId)
          );
        allow delete: if false;
      }

      // Módulos 3.5/4 — destinos e operações auditáveis de consumo.
      match /destinations/{destinationId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseDestinationCreate(workspaceId, destinationId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseDestinationUpdate(workspaceId, destinationId);
        allow delete: if false;
      }


      match /withdrawals/{withdrawalId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && validWarehouseWithdrawalCreate(workspaceId, withdrawalId);
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseWithdrawalUpdate(workspaceId, withdrawalId);
        allow delete: if false;
      }

      match /consumptions/{consumptionId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && (
            (
              request.resource.data.origin == 'IMMEDIATE_CONSUMPTION'
              && request.resource.data.movementId == null
              && request.resource.data.materialId == null
              && validWarehouseImmediateConsumptionLightCreate(workspaceId, consumptionId)
            )
            || validWarehouseConsumptionCreate(workspaceId, consumptionId)
          );
        allow update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseConsumptionUpdate(workspaceId, consumptionId);
        allow delete: if false;
      }

      // Cancelamento/devolução — marcador-resumo leve.
      // A saída original permanece imutável; o estoque retorna pelo motor
      // oficial MANUAL_ENTRY + TRANSFER.
      match /outboundReturns/{consumptionId} {
        allow read: if canAccessWarehouseModule(workspaceId);

        allow create: if canAccessWarehouseModule(workspaceId)
          && request.resource.data is map
          && request.resource.data.schemaVersion == 'warehouse_outbound_return_v1'
          && request.resource.data.id == consumptionId
          && request.resource.data.consumptionId == consumptionId
          && consumptionId.matches('^cons_[a-f0-9]{64}$')
          && request.resource.data.workspaceId == workspaceId
          && warehouseUgMatchesAccess(workspaceId, request.resource.data.ug)
          && request.resource.data.materialId is string
          && request.resource.data.materialId.matches('^mat_[a-f0-9]{32}$')
          && request.resource.data.originalQuantity is number
          && request.resource.data.originalQuantity > 0
          && request.resource.data.returnedQuantity is number
          && request.resource.data.returnedQuantity >= 0
          && request.resource.data.returnedQuantity <= request.resource.data.originalQuantity
          && request.resource.data.pendingOperationId is string
          && request.resource.data.pendingQuantity is number
          && request.resource.data.pendingQuantity > 0
          && request.resource.data.returnedQuantity + request.resource.data.pendingQuantity
            <= request.resource.data.originalQuantity
          && request.resource.data.pendingReason is string
          && request.resource.data.pendingReason.size() > 0
          && request.resource.data.pendingReason.size() <= 180
          && request.resource.data.pendingBy == request.auth.uid
          && request.resource.data.lastReturnOperationId == null
          && request.resource.data.lastReturnMovementId == null
          && request.resource.data.lastReturnAt == null
          && request.resource.data.lastReturnBy == null
          && request.resource.data.lastReturnReason == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canAccessWarehouseModule(workspaceId)
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.id == resource.data.id
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.ug == resource.data.ug
          && request.resource.data.consumptionId == resource.data.consumptionId
          && request.resource.data.materialId == resource.data.materialId
          && request.resource.data.originalQuantity == resource.data.originalQuantity
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.returnedQuantity is number
          && request.resource.data.returnedQuantity >= resource.data.returnedQuantity
          && request.resource.data.returnedQuantity <= resource.data.originalQuantity
          && (
            (
              request.resource.data.returnedQuantity == resource.data.returnedQuantity
              && request.resource.data.pendingOperationId is string
              && request.resource.data.pendingQuantity is number
              && request.resource.data.pendingQuantity > 0
              && request.resource.data.returnedQuantity
                + request.resource.data.pendingQuantity
                <= resource.data.originalQuantity
              && request.resource.data.pendingReason is string
              && request.resource.data.pendingReason.size() > 0
              && request.resource.data.pendingReason.size() <= 180
              && request.resource.data.pendingBy == request.auth.uid
              && request.resource.data.lastReturnOperationId == resource.data.lastReturnOperationId
              && request.resource.data.lastReturnMovementId == resource.data.lastReturnMovementId
              && request.resource.data.lastReturnAt == resource.data.lastReturnAt
              && request.resource.data.lastReturnBy == resource.data.lastReturnBy
              && request.resource.data.lastReturnReason == resource.data.lastReturnReason
            )
            || (
              resource.data.pendingOperationId is string
              && resource.data.pendingQuantity is number
              && resource.data.pendingQuantity > 0
              && resource.data.pendingBy == request.auth.uid
              && request.resource.data.pendingOperationId == null
              && request.resource.data.pendingQuantity == null
              && request.resource.data.pendingReason == null
              && request.resource.data.pendingBy == null
              && request.resource.data.returnedQuantity
                == resource.data.returnedQuantity + resource.data.pendingQuantity
              && request.resource.data.lastReturnOperationId == resource.data.pendingOperationId
              && request.resource.data.lastReturnMovementId is string
              && request.resource.data.lastReturnMovementId.matches('^mov_[a-f0-9]{64}$')
              && request.resource.data.lastReturnAt == request.time
              && request.resource.data.lastReturnBy == request.auth.uid
              && request.resource.data.lastReturnReason == resource.data.pendingReason
            )
          );

        allow delete: if false;
      }

      // Performance R3 / PERF-D — índice derivado e não autoritativo da fila.
      // Serve apenas para descobrir identidades operacionais ainda candidatas.
      match /intakeQueueIndex/{entryId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create, update: if canAccessWarehouseModule(workspaceId)
          && validWarehouseIntakeQueueIndexEntry(workspaceId, entryId);
        allow delete: if false;
      }

      // Fila ADM — marcador lógico founder-only; não é fonte canônica nem quantitativa.
      // Validação de payload permanece no repository; Rules preservam a fronteira
      // de identidade/workspace e proíbem exclusão física do marcador.
      match /queueExclusions/{exclusionId} {
        allow read, create, update: if canAccessWarehouseModule(workspaceId);
        allow delete: if false;
      }

      // FASE 11.5 — fila de entrada/alocação de itens recebidos por NF.
      match /intakes/{intakeId} {
        allow read: if canAccessWarehouseModule(workspaceId);
        allow create: if canAccessWarehouseModule(workspaceId)
          && (
            (
              request.resource.data.schemaVersion == 'warehouse_item_intake_v1'
              && validWarehouseItemIntakeCreate(workspaceId, intakeId)
            )
            || (
              request.resource.data.schemaVersion == 'warehouse_item_intake_v2'
              && request.resource.data.materialId == null
              && request.resource.data.allocatedQuantity == 0
              && request.resource.data.pendingQuantity == 0
              && request.resource.data.status == 'PROCESSED'
              && validWarehouseImmediateIntakeV2Create(workspaceId, intakeId)
            )
            || (
              request.resource.data.schemaVersion == 'warehouse_item_intake_v2'
              && validWarehouseItemIntakeV2Create(workspaceId, intakeId)
            )
          );
        allow update: if canAccessWarehouseModule(workspaceId)
          && (
            (
              resource.data.schemaVersion == 'warehouse_item_intake_v1'
              && request.resource.data.schemaVersion == 'warehouse_item_intake_v1'
              && validWarehouseItemIntakeUpdate(workspaceId, intakeId)
            )
            || (
              resource.data.schemaVersion == 'warehouse_item_intake_v2'
              && request.resource.data.schemaVersion == 'warehouse_item_intake_v2'
              && validWarehouseItemIntakeV2Update(workspaceId, intakeId)
            )
          );
        allow delete: if false;
      }

      // FASE 11 / DEP-23.1 — alertas logísticos pertencem exclusivamente ao ADM.

      // FASE 10 / DEP-20..20.3 — inventário founder-only e auditável.
    }
  }
}
