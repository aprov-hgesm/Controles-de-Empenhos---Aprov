    function validWarehouseInventoryAdjustmentUpdate(workspaceId, inventoryId, itemId) {
      let s = /databases/$(database)/documents/warehouse/$(workspaceId)/inventories/$(inventoryId);
      let m = /databases/$(database)/documents/warehouse/$(workspaceId)/movements/$(request.resource.data.adjustmentMovementId);
      return warehouseInventoryItemIdentityUnchanged()
        && get(s).data.status == 'CONFIRMING'
        && resource.data.status == 'DIVERGENT'
        && request.resource.data.status == 'ADJUSTED'
        && request.resource.data.countedQuantity == resource.data.countedQuantity
        && request.resource.data.difference == resource.data.difference
        && request.resource.data.countedBy == resource.data.countedBy
        && request.resource.data.countedAt == resource.data.countedAt
        && request.resource.data.adjustedBy == request.auth.uid
        && request.resource.data.adjustedAt == request.time
        && !exists(m)
        && existsAfter(m)
        && getAfter(m).data.type == 'INVENTORY_ADJUSTMENT'
        && getAfter(m).data.source.inventoryId == inventoryId
        && getAfter(m).data.source.inventoryItemId == itemId
        && getAfter(m).data.quantityDelta == resource.data.difference
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','adjustmentMovementId','adjustedBy','adjustedAt'
        ]);
    }

    function validWarehouseInventoryStaleUpdate(workspaceId, inventoryId, itemId) {
      let s = /databases/$(database)/documents/warehouse/$(workspaceId)/inventories/$(inventoryId);
      return warehouseInventoryItemIdentityUnchanged()
        && resource.data.status == 'DIVERGENT'
        && request.resource.data.status == 'STALE'
        && request.resource.data.countedQuantity == resource.data.countedQuantity
        && request.resource.data.difference == resource.data.difference
        && existsAfter(s)
        && getAfter(s).data.status == 'RECONCILIATION_REQUIRED'
