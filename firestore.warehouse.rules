    function warehouseItemIntakeV2StatusMatchesQuantities() {
      return (
          request.resource.data.status == 'PENDING'
          && request.resource.data.allocatedQuantity == 0
          && request.resource.data.immediateConsumptionQuantity == 0
          && request.resource.data.pendingQuantity == request.resource.data.receivedQuantity
        )
        || (
          request.resource.data.status == 'PARTIALLY_PROCESSED'
          && request.resource.data.allocatedQuantity + request.resource.data.immediateConsumptionQuantity > 0
          && request.resource.data.pendingQuantity > 0
        )
        || (
          request.resource.data.status == 'PROCESSED'
          && request.resource.data.pendingQuantity == 0
          && request.resource.data.allocatedQuantity + request.resource.data.immediateConsumptionQuantity == request.resource.data.receivedQuantity
        );
    }

