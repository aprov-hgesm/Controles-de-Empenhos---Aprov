    function validWarehouseWithdrawalBase(workspaceId, withdrawalId) {
      return request.resource.data is map
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'id', 'workspaceId', 'ug', 'destinationId',
          'destinationName', 'withdrawnBy', 'payloadHash',
          'expectedLineCount', 'appliedLineCount', 'status',
