        && request.resource.data.logicalHeight >= 240
        && request.resource.data.logicalHeight <= 50000
        && request.resource.data.objects is list
        && request.resource.data.objects.size() <= 160
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.version <= 100000
        && request.resource.data.status in ['active', 'archived']
        && (
          (
            request.resource.data.version == 1
            && request.resource.data.previousVersionId == null
          )
          || (
            request.resource.data.version > 1
            && request.resource.data.previousVersionId is string
