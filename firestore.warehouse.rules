    function validWarehouseWithdrawalUpdate(workspaceId, withdrawalId) {
      return validWarehouseWithdrawalBase(workspaceId, withdrawalId)
        && resource.data.schemaVersion == 'warehouse_material_withdrawal_v1'
        && resource.data.status != 'FINALIZED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'appliedLineCount', 'status', 'updatedAt', 'finalizedAt'
        ])
        && request.resource.data.appliedLineCount >= resource.data.appliedLineCount
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'PARTIALLY_APPLIED'
            && request.resource.data.appliedLineCount > 0
            && request.resource.data.appliedLineCount
              <= request.resource.data.expectedLineCount
