    function validWarehouseInventoryCountUpdate(workspaceId, inventoryId) {
      let s = /databases/$(database)/documents/warehouse/$(workspaceId)/inventories/$(inventoryId);
      return warehouseInventoryItemIdentityUnchanged()
        && exists(s)
        && get(s).data.status == 'COUNTING'
        && resource.data.status in ['PENDING','MATCHED','DIVERGENT']
        && request.resource.data.countedQuantity is number
        && request.resource.data.countedQuantity >= 0
        && request.resource.data.difference == request.resource.data.countedQuantity - request.resource.data.expectedQuantity
        && ((request.resource.data.difference == 0 && request.resource.data.status == 'MATCHED')
          || (request.resource.data.difference != 0 && request.resource.data.status == 'DIVERGENT'))
        && request.resource.data.countedBy == request.auth.uid
        && request.resource.data.countedAt == request.time
        && request.resource.data.adjustmentMovementId == null
        && request.resource.data.adjustedBy == null
        && request.resource.data.adjustedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'countedQuantity','difference','status','countedBy','countedAt',
          'adjustmentMovementId','adjustedBy','adjustedAt'
        ]);
