    function warehouseItemIntakeMaterialMatches(workspaceId) {
      let p = /databases/$(database)/documents/warehouse/$(workspaceId)/materials/$(request.resource.data.materialId);
      return exists(p)
        && get(p).data.workspaceId == workspaceId
        && get(p).data.ug == request.resource.data.ug
