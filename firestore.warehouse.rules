    function warehouseAllocatedIntakeReferencesMatch(workspaceId) {
      let entryPath = /databases/$(database)/documents/warehouse/$(workspaceId)/movements/$(request.resource.data.entryMovementId);
      let transferPath = /databases/$(database)/documents/warehouse/$(workspaceId)/movements/$(request.resource.data.transferMovementId);
      let lotPath = /databases/$(database)/documents/warehouse/$(workspaceId)/lots/$(request.resource.data.lotId);
      let entry = get(entryPath).data;
      let transfer = get(transferPath).data;
      let lot = get(lotPath).data;
      return request.resource.data.mode == 'ALLOCATED'
        && request.resource.data.position is map
        && request.resource.data.position.kind != 'UNASSIGNED'
        && validWarehouseStockPosition(request.resource.data.position)
        && request.resource.data.lotId is string
        && request.resource.data.lotId.matches('^lot_[a-f0-9]{32}$')
        && request.resource.data.lotCode is string
        && request.resource.data.lotCode.size() > 0
        && request.resource.data.lotCode.size() <= 80
        && request.resource.data.entryMovementId is string
        && request.resource.data.entryMovementId.matches('^mov_[a-f0-9]{64}$')
        && request.resource.data.transferMovementId is string
        && request.resource.data.transferMovementId.matches('^mov_[a-f0-9]{64}$')
        && request.resource.data.siscofisStatus == 'NOT_APPLICABLE'
        && exists(entryPath)
        && entry.type == 'INVOICE_ENTRY'
        && entry.materialId == request.resource.data.materialId
        && entry.source is map
        && entry.source.kind == 'INVOICE'
        && entry.source.invoiceRecordKey == request.resource.data.invoiceRecordKey
        && request.resource.data.itemId in entry.source.itemIds
        && exists(transferPath)
        && transfer.type == 'TRANSFER'
        && transfer.materialId == request.resource.data.materialId
        && transfer.source is map
        && transfer.source.kind == 'LOCATION_TRANSFER'
        && transfer.source.to == request.resource.data.position
        && exists(lotPath)
        && lot.materialId == request.resource.data.materialId
        && lot.position == request.resource.data.position
        && lot.code == request.resource.data.lotCode
        && lot.quantity == request.resource.data.quantity;
    }

    function warehouseImmediateIntakeIsValid() {
      return request.resource.data.mode == 'IMMEDIATE_CONSUMPTION'
        && request.resource.data.position == null
        && request.resource.data.lotId == null
        && request.resource.data.lotCode == null
        && request.resource.data.expiresOn == null
        && request.resource.data.entryMovementId == null
        && request.resource.data.transferMovementId == null
        && request.resource.data.siscofisStatus in ['PENDING', 'POSTED'];
