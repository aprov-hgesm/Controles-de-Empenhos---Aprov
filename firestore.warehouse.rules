    function warehouseConsumptionMovementMatches(workspaceId) {
      let movementPath = /databases/$(database)/documents/warehouse/$(workspaceId)/movements/$(request.resource.data.movementId);
      return existsAfter(movementPath)
        && getAfter(movementPath).data.workspaceId == workspaceId
        && getAfter(movementPath).data.ug == request.resource.data.ug
        && getAfter(movementPath).data.materialId == request.resource.data.materialId
        && getAfter(movementPath).data.type == 'OUTBOUND';
    }

    function warehouseImmediateConsumptionIntakeMatchesAfter(workspaceId) {
      let intakePath = /databases/$(database)/documents/warehouse/$(workspaceId)/intakes/$(request.resource.data.intakeId);
      let intakeExists = exists(intakePath);
      let intakeBefore = get(intakePath).data;
      let intakeAfter = getAfter(intakePath).data;
      return existsAfter(intakePath)
        && intakeAfter.workspaceId == workspaceId
        && intakeAfter.ug == request.resource.data.ug
        && intakeAfter.invoiceRecordKey == request.resource.data.invoiceRecordKey
        && intakeAfter.status in ['PARTIALLY_PROCESSED', 'PROCESSED']
        && (
          (
            intakeExists
            && intakeAfter.immediateConsumptionQuantity
              == intakeBefore.immediateConsumptionQuantity
                + request.resource.data.quantity
          )
          || (
            !intakeExists
            && intakeAfter.immediateConsumptionQuantity
              == request.resource.data.quantity
          )
        );
