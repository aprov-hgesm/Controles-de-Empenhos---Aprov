        && request.resource.data.expectedQuantity is number
        && request.resource.data.expectedQuantity >= 0
        && request.resource.data.expectedBalanceRevision is int
        && request.resource.data.expectedBalanceRevision >= 1
        && request.resource.data.expectedLocationRevision is int
        && request.resource.data.expectedLocationRevision >= 1
        && request.resource.data.status == 'PENDING'
        && request.resource.data.countedQuantity == null
        && request.resource.data.difference == null
        && request.resource.data.countedBy == null
        && request.resource.data.countedAt == null
        && request.resource.data.adjustmentMovementId == null
        && request.resource.data.adjustedBy == null
        && request.resource.data.adjustedAt == null
        && exists(s)
        && get(s).data.status == 'OPENING'
        && get(s).data.ug == request.resource.data.ug;
