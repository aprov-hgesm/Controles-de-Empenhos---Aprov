    function warehouseLayoutPreviousVersionArchivedAfter(workspaceId, previousId, expectedUg, expectedDepotId, expectedVersion) {
      let previousPath = /databases/$(database)/documents/warehouse/$(workspaceId)/layouts/$(previousId);
      return previousId is string
        && previousId.matches('^lay_[a-f0-9]{32}$')
        && exists(previousPath)
        && get(previousPath).data.schemaVersion == 'warehouse_depot_layout_v1'
        && get(previousPath).data.workspaceId == workspaceId
        && get(previousPath).data.ug == expectedUg
        && get(previousPath).data.depotId == expectedDepotId
        && get(previousPath).data.version == expectedVersion
        && get(previousPath).data.status == 'active'
        && existsAfter(previousPath)
        && getAfter(previousPath).data.status == 'archived';
    }

    function warehouseLayoutPreviousVersionTransitionIsValid(workspaceId) {
      return request.resource.data.version == 1
        || warehouseLayoutPreviousVersionArchivedAfter(
          workspaceId,
          request.resource.data.previousVersionId,
          request.resource.data.ug,
          request.resource.data.depotId,
          request.resource.data.version - 1
