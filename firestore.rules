rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn();
    }

    function isOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validations
    function isValidEmpenho(data) {
      return data.keys().hasAll(['id', 'supplier', 'description', 'date', 'status', 'items', 'userId'])
        && data.keys().size() <= 16
        && data.id is string && data.id.size() <= 128
        && data.supplier is string && data.supplier.size() <= 300
        && data.description is string && data.description.size() <= 1000
        && data.date is string && data.date.size() <= 50
        && data.status is string
        && data.items is list
        && data.userId == request.auth.uid;
    }

    function isValidAlert(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'subtitle', 'description', 'date', 'userId'])
        && data.keys().size() <= 12
        && data.id is string && data.id.size() <= 128
        && data.type is string
        && data.title is string && data.title.size() <= 300
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.description is string && data.description.size() <= 1000
        && data.date is string && data.date.size() <= 50
        && data.userId == request.auth.uid;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'empenhoId', 'issueDate', 'items', 'totalValue', 'supplier', 'userId'])
        && data.keys().size() <= 16
        && data.id is string && data.id.size() <= 128
        && data.empenhoId is string && data.empenhoId.size() <= 128
        && data.issueDate is string && data.issueDate.size() <= 50
        && data.items is list
        && data.totalValue is number && data.totalValue >= 0
        && data.supplier is string && data.supplier.size() <= 300
        && data.userId == request.auth.uid;
    }

    function isValidComissao(data) {
      return data.keys().hasAll(['id', 'mesReferencia', 'boletimNumero', 'boletimData', 'presidente', 'auxiliares', 'userId'])
        && data.keys().size() <= 12
        && data.id is string && data.id.size() <= 128
        && data.mesReferencia is string && data.mesReferencia.size() <= 30
        && data.boletimNumero is string && data.boletimNumero.size() <= 128
        && data.boletimData is string && data.boletimData.size() <= 50
        && data.presidente is map
        && data.auxiliares is list
        && data.userId == request.auth.uid;
    }

    // Collection match blocks
    match /empenhos/{empenhoId} {
      allow read: if isOwner(existing());
      allow create: if isEmailVerified() && isValidId(empenhoId) && isValidEmpenho(incoming());
      allow update: if isEmailVerified() && isOwner(existing()) && isValidEmpenho(incoming()) 
        && incoming().userId == existing().userId
        && incoming().id == existing().id;
      allow delete: if isEmailVerified() && isOwner(existing());
    }

    match /alerts/{alertId} {
      allow read: if isOwner(existing());
      allow create: if isEmailVerified() && isValidId(alertId) && isValidAlert(incoming());
      allow update: if isEmailVerified() && isOwner(existing()) && isValidAlert(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;
      allow delete: if isEmailVerified() && isOwner(existing());
    }

    match /invoices/{invoiceId} {
      allow read: if isOwner(existing());
      allow create: if isEmailVerified() && isValidId(invoiceId) && isValidInvoice(incoming());
      allow update: if isEmailVerified() && isOwner(existing()) && isValidInvoice(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;
      allow delete: if isEmailVerified() && isOwner(existing());
    }

    match /comissoes/{comissaoId} {
      allow read: if isOwner(existing());
      allow create: if isEmailVerified() && isValidId(comissaoId) && isValidComissao(incoming());
      allow update: if isEmailVerified() && isOwner(existing()) && isValidComissao(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;
      allow delete: if isEmailVerified() && isOwner(existing());
    }
  }
}
