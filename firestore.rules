rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isAuthorizedUser() {
      return isVerifiedUser()
        && request.auth.token.email == 'aprov1hgesm@gmail.com';
    }

    function isPlatformAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'aprov1hgesm@gmail.com';
    }

    // Diretórios administrativos da plataforma. A conta institucional fundadora
    // alterna entre o perfil operacional e o perfil administrativo na interface.
    match /workspaces/{id} {
      allow read, create: if isPlatformAdmin();
    }

    match /platformAccounts/{id} {
      allow read, create: if isPlatformAdmin();
    }

    // Coleções operacionais legadas do HGeSM permanecem restritas à mesma conta.
    match /empenhos/{id} {
      allow read, write: if isAuthorizedUser();
    }

    match /alerts/{id} {
      allow read, write: if isAuthorizedUser();
    }

    match /invoices/{id} {
      allow read, write: if isAuthorizedUser();
    }

    match /comissoes/{id} {
      allow read, write: if isAuthorizedUser();
    }

    match /cronogramas/{id} {
      allow read, write: if isAuthorizedUser();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAuthorizedUser();
    }
  }
}
