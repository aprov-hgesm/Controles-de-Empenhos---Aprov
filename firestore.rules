rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function hasSignInProvider(provider) {
      return isVerifiedUser()
        && request.auth.token.firebase is map
        && request.auth.token.firebase.sign_in_provider == provider;
    }

    function isPasswordSectorSession() {
      return hasSignInProvider('password');
    }

    function isGoogleFounderSession() {
      return hasSignInProvider('google.com');
    }

    function isHgesmFounder() {
      return isVerifiedUser()
        && request.auth.token.email == 'aprov1hgesm@gmail.com'
        && isGoogleFounderSession();
    }

    function isPlatformAdmin() {
      // A identidade fundadora alterna entre os perfis operacional e administrativo
      // apenas na interface. As Rules autorizam a identidade Firebase, não o modo UI.
      return isHgesmFounder();
    }

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function workspaceData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function workspaceAccountExists(workspaceId) {
      return workspaceExists(workspaceId)
        && workspaceData(workspaceId).authorizedEmail is string
        && exists(
          /databases/$(database)/documents/platformAccounts/$(workspaceData(workspaceId).authorizedEmail)
        );
    }

    function workspaceAccountData(workspaceId) {
      return get(
        /databases/$(database)/documents/platformAccounts/$(workspaceData(workspaceId).authorizedEmail)
      ).data;
    }

    function isValidUnitUg(value) {
      return value is string
        && value.matches('^[0-9]{6}$');
    }

    function workspaceAndAccountUgMatch(workspaceId) {
      let workspace = workspaceData(workspaceId);
      let account = workspaceAccountData(workspaceId);
      return (
          !('ug' in workspace)
          && !('ug' in account)
        )
        || (
          'ug' in workspace
          && 'ug' in account
          && isValidUnitUg(workspace.ug)
          && workspace.ug == account.ug
        );
    }

    function hasBoundUid(account) {
      return 'firebaseUid' in account
        && account.firebaseUid is string
        && account.firebaseUid.size() > 0;
    }

    function sectorAccountUsesPasswordProvider(account) {
      return !('authProvider' in account)
        || account.authProvider == 'password';
    }

    function identityMatchesAccount(account) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(account)
        && account.email == request.auth.token.email
        && (
          (
            hasBoundUid(account)
            && account.firebaseUid == request.auth.uid
          )
          || !hasBoundUid(account)
        );
    }

    function boundIdentityMatchesAccount(account) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(account)
        && account.email == request.auth.token.email
        && hasBoundUid(account)
        && account.firebaseUid == request.auth.uid;
    }

    function operationalIdentityMatchesAccount(workspaceId, account) {
      return (
          workspaceId == 'hgesm-aprov'
          && isHgesmFounder()
          && account.email == 'aprov1hgesm@gmail.com'
        )
        || boundIdentityMatchesAccount(account);
    }

    function canAccessWorkspace(workspaceId) {
      let workspace = workspaceData(workspaceId);
      let account = workspaceAccountData(workspaceId);
      return workspaceAccountExists(workspaceId)
        && workspace.status == 'active'
        && account.accountType == 'sector'
        && account.status == 'active'
        && account.workspaceId == workspaceId
        && account.email == workspace.authorizedEmail
        && (
          (
            !('ug' in workspace)
            && !('ug' in account)
          )
          || (
            'ug' in workspace
            && 'ug' in account
            && isValidUnitUg(workspace.ug)
            && workspace.ug == account.ug
          )
        )
        && operationalIdentityMatchesAccount(workspaceId, account);
    }

    function isValidSessionSlotId(slotId) {
      return slotId in ['slot-1', 'slot-2'];
    }

    function validWorkspaceSessionLeaseShape(workspaceId, slotId) {
      let workspace = workspaceData(workspaceId);
      return canAccessWorkspace(workspaceId)
        && !isHgesmFounder()
        && isValidSessionSlotId(slotId)
        && 'ug' in workspace
        && isValidUnitUg(workspace.ug)
        && request.resource.data.keys().hasAll([
          'leaseVersion',
          'slotId',
          'sessionId',
          'workspaceId',
          'ug',
          'uid',
          'accountEmail',
          'browserInstanceId',
          'startedAt',
          'lastSeenAt',
          'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'leaseVersion',
          'slotId',
          'sessionId',
          'workspaceId',
          'ug',
          'uid',
          'accountEmail',
          'browserInstanceId',
          'startedAt',
          'lastSeenAt',
          'expiresAt'
        ])
        && request.resource.data.leaseVersion == 'emprovex_session_v1'
        && request.resource.data.slotId == slotId
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.ug == workspace.ug
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.accountEmail == request.auth.token.email
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 8
        && request.resource.data.browserInstanceId is string
        && request.resource.data.browserInstanceId.size() > 8
        && request.resource.data.startedAt is timestamp
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time + duration.value(25, 'm')
        && request.resource.data.expiresAt <= request.time + duration.value(35, 'm');
    }

    function validWorkspaceSessionLeaseCreate(workspaceId, slotId) {
      return validWorkspaceSessionLeaseShape(workspaceId, slotId)
        && request.resource.data.startedAt == request.time;
    }

    function sameWorkspaceSessionLeaseOwner() {
      return resource.data.uid == request.auth.uid
        && resource.data.accountEmail == request.auth.token.email
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountEmail == resource.data.accountEmail
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.browserInstanceId == resource.data.browserInstanceId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.ug == resource.data.ug
        && request.resource.data.slotId == resource.data.slotId
        && request.resource.data.leaseVersion == resource.data.leaseVersion;
    }

    function validWorkspaceSessionLeaseUpdate(workspaceId, slotId) {
      // Avalia o shape/tenant uma única vez. Separar renewal e takeover em duas
      // branches completas excedia o orçamento de 1000 expressões das Rules.
      return validWorkspaceSessionLeaseShape(workspaceId, slotId)
        && (
          (
            sameWorkspaceSessionLeaseOwner()
            && request.resource.data.startedAt == resource.data.startedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastSeenAt',
              'expiresAt'
            ])
          )
          || (
            resource.data.expiresAt is timestamp
            && resource.data.expiresAt <= request.time
            && request.resource.data.startedAt == request.time
          )
        );
    }

    function validWorkspaceSessionLeaseDelete(workspaceId, slotId) {
      return canAccessWorkspace(workspaceId)
        && !isHgesmFounder()
        && isValidSessionSlotId(slotId)
        && resource.data.workspaceId == workspaceId
        && resource.data.slotId == slotId
        && resource.data.uid == request.auth.uid
        && resource.data.accountEmail == request.auth.token.email;
    }

    function validWorkspaceUsageCounter(value) {
      return value is number && value >= 0;
    }

    function validWorkspaceUsageEstimate(workspaceId, dayKey) {
      let workspace = workspaceData(workspaceId);
      return canAccessWorkspace(workspaceId)
        && 'ug' in workspace
        && isValidUnitUg(workspace.ug)
        && request.resource.data.keys().hasAll([
          'telemetryVersion',
          'source',
          'workspaceId',
          'ug',
          'dayKey',
          'windowStartedAt',
          'windowEndedAt',
          'estimatedDocumentReads',
          'estimatedDocumentWrites',
          'estimatedDocumentDeletes',
          'realtimeSnapshots',
          'peakRealtimeListeners',
          'telemetryFlushes',
          'lastReportedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'telemetryVersion',
          'source',
          'workspaceId',
          'ug',
          'dayKey',
          'windowStartedAt',
          'windowEndedAt',
          'estimatedDocumentReads',
          'estimatedDocumentWrites',
          'estimatedDocumentDeletes',
          'realtimeSnapshots',
          'peakRealtimeListeners',
          'telemetryFlushes',
          'lastReportedAt'
        ])
        && request.resource.data.telemetryVersion == 'emprovex_usage_v1'
        && request.resource.data.source == 'emprovex-workspace-estimate'
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.ug == workspace.ug
        && request.resource.data.dayKey == dayKey
        && request.resource.data.windowStartedAt is string
        && request.resource.data.windowEndedAt is string
        && validWorkspaceUsageCounter(request.resource.data.estimatedDocumentReads)
        && validWorkspaceUsageCounter(request.resource.data.estimatedDocumentWrites)
        && validWorkspaceUsageCounter(request.resource.data.estimatedDocumentDeletes)
        && validWorkspaceUsageCounter(request.resource.data.realtimeSnapshots)
        && validWorkspaceUsageCounter(request.resource.data.peakRealtimeListeners)
        && validWorkspaceUsageCounter(request.resource.data.telemetryFlushes)
        && request.resource.data.lastReportedAt == request.time;
    }

    function validWorkspaceUsageEstimateCreate(workspaceId, dayKey) {
      return validWorkspaceUsageEstimate(workspaceId, dayKey);
    }

    function validWorkspaceUsageEstimateUpdate(workspaceId, dayKey) {
      return validWorkspaceUsageEstimate(workspaceId, dayKey)
        && request.resource.data.telemetryVersion == resource.data.telemetryVersion
        && request.resource.data.source == resource.data.source
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.ug == resource.data.ug
        && request.resource.data.dayKey == resource.data.dayKey
        && request.resource.data.windowStartedAt == resource.data.windowStartedAt
        && request.resource.data.windowEndedAt == resource.data.windowEndedAt
        && request.resource.data.estimatedDocumentReads >= resource.data.estimatedDocumentReads
        && request.resource.data.estimatedDocumentWrites >= resource.data.estimatedDocumentWrites
        && request.resource.data.estimatedDocumentDeletes >= resource.data.estimatedDocumentDeletes
        && request.resource.data.realtimeSnapshots >= resource.data.realtimeSnapshots
        && request.resource.data.peakRealtimeListeners >= resource.data.peakRealtimeListeners
        && request.resource.data.telemetryFlushes > resource.data.telemetryFlushes;
    }

    function validSessionRevocationCreate(workspaceId, sessionId) {
      return isPlatformAdmin()
        && request.resource.data.keys().hasAll([
          'revocationVersion',
          'sessionId',
          'workspaceId',
          'ug',
          'uid',
          'accountEmail',
          'slotId',
          'createdAt',
          'createdBy',
          'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'revocationVersion',
          'sessionId',
          'workspaceId',
          'ug',
          'uid',
          'accountEmail',
          'slotId',
          'createdAt',
          'createdBy',
          'expiresAt'
        ])
        && request.resource.data.revocationVersion == 'emprovex_session_revocation_v1'
        && request.resource.data.sessionId == sessionId
        && request.resource.data.workspaceId == workspaceId
        && isValidUnitUg(request.resource.data.ug)
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.accountEmail is string
        && request.resource.data.accountEmail.size() > 3
        && isValidSessionSlotId(request.resource.data.slotId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
    }

    function validAdminSessionSlotDelete(workspaceId, slotId) {
      return isPlatformAdmin()
        && isValidSessionSlotId(slotId)
        && resource.data.workspaceId == workspaceId
        && resource.data.slotId == slotId
        && existsAfter(
          /databases/$(database)/documents/workspaces/$(workspaceId)/sessionRevocations/$(resource.data.sessionId)
        )
        && getAfter(
          /databases/$(database)/documents/workspaces/$(workspaceId)/sessionRevocations/$(resource.data.sessionId)
        ).data.sessionId == resource.data.sessionId
        && getAfter(
          /databases/$(database)/documents/workspaces/$(workspaceId)/sessionRevocations/$(resource.data.sessionId)
        ).data.uid == resource.data.uid
        && getAfter(
          /databases/$(database)/documents/workspaces/$(workspaceId)/sessionRevocations/$(resource.data.sessionId)
        ).data.slotId == slotId;
    }

    function canReadWorkspaceMetadataFromResource(workspaceId) {
      return isVerifiedUser()
        && resource.data.id == workspaceId
        && resource.data.authorizedEmail is string
        && exists(
          /databases/$(database)/documents/platformAccounts/$(resource.data.authorizedEmail)
        )
        && get(
          /databases/$(database)/documents/platformAccounts/$(resource.data.authorizedEmail)
        ).data.accountType == 'sector'
        && get(
          /databases/$(database)/documents/platformAccounts/$(resource.data.authorizedEmail)
        ).data.workspaceId == workspaceId
        && workspaceAndAccountUgMatch(workspaceId)
        && identityMatchesAccount(
          get(
            /databases/$(database)/documents/platformAccounts/$(resource.data.authorizedEmail)
          ).data
        );
    }

    function validWorkspaceWrite(workspaceId) {
      return request.resource.data.keys().hasAll([
          'id',
          'name',
          'status',
          'authorizedEmail',
          'institutionalProfile',
          'createdAt',
          'updatedAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'status',
          'authorizedEmail',
          'ug',
          'legacyWorkspace',
          'institutionalProfile',
          'createdAt',
          'updatedAt',
          'createdBy'
        ])
        && request.resource.data.id == workspaceId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.authorizedEmail is string
        && request.resource.data.authorizedEmail.size() > 3
        && (
          !('ug' in request.resource.data)
          || isValidUnitUg(request.resource.data.ug)
        )
        && request.resource.data.status in ['active', 'disabled']
        && request.resource.data.institutionalProfile is map;
    }

    function workspaceHasMatchingAccountAfterWrite(workspaceId) {
      return request.resource.data.authorizedEmail is string
        && existsAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.authorizedEmail)
        )
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.authorizedEmail)
        ).data.accountType == 'sector'
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.authorizedEmail)
        ).data.email == request.resource.data.authorizedEmail
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.authorizedEmail)
        ).data.workspaceId == workspaceId
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.authorizedEmail)
        ).data.status == request.resource.data.status
        && (
          (
            !('ug' in request.resource.data)
            && !('ug' in getAfter(
              /databases/$(database)/documents/platformAccounts/$(request.resource.data.authorizedEmail)
            ).data)
          )
          || (
            'ug' in request.resource.data
            && 'ug' in getAfter(
              /databases/$(database)/documents/platformAccounts/$(request.resource.data.authorizedEmail)
            ).data
            && request.resource.data.ug == getAfter(
              /databases/$(database)/documents/platformAccounts/$(request.resource.data.authorizedEmail)
            ).data.ug
          )
        );
    }

    function validWorkspaceCreate(workspaceId) {
      return validWorkspaceWrite(workspaceId)
        && 'ug' in request.resource.data
        && isValidUnitUg(request.resource.data.ug);
    }

    function validWorkspaceAdminUpdate(workspaceId) {
      return validWorkspaceWrite(workspaceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'status',
          'ug',
          'institutionalProfile',
          'updatedAt'
        ])
        && (
          !('ug' in resource.data)
          || request.resource.data.ug == resource.data.ug
        );
    }

    function validSectorAccountWrite(accountId) {
      return request.resource.data.keys().hasAll([
          'email',
          'accountType',
          'workspaceId',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'authProvider',
          'firebaseUid',
          'accountType',
          'workspaceId',
          'ug',
          'status',
          'createdAt',
          'updatedAt',
          'createdBy',
          'firstLoginAt',
          'lastLoginAt'
        ])
        && request.resource.data.email == accountId
        && request.resource.data.accountType == 'sector'
        && (
          !('authProvider' in request.resource.data)
          || request.resource.data.authProvider == 'password'
        )
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId.size() > 0
        && (
          !('ug' in request.resource.data)
          || isValidUnitUg(request.resource.data.ug)
        )
        && request.resource.data.status in ['active', 'disabled'];
    }

    function validSectorAccountCreate(accountId) {
      return validSectorAccountWrite(accountId)
        && 'ug' in request.resource.data
        && isValidUnitUg(request.resource.data.ug);
    }

    function accountHasMatchingWorkspaceAfterWrite(accountId) {
      return request.resource.data.workspaceId is string
        && existsAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        )
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.id == request.resource.data.workspaceId
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.authorizedEmail == accountId
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.status == request.resource.data.status
        && (
          (
            !('ug' in request.resource.data)
            && !('ug' in getAfter(
              /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
            ).data)
          )
          || (
            'ug' in request.resource.data
            && 'ug' in getAfter(
              /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
            ).data
            && request.resource.data.ug == getAfter(
              /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
            ).data.ug
          )
        );
    }

    function validSectorAccountAdminUpdate(accountId) {
      return validSectorAccountWrite(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'ug',
          'updatedAt'
        ])
        && (
          !('ug' in resource.data)
          || request.resource.data.ug == resource.data.ug
        );
    }

    function validPlatformBillingConfig() {
      return request.resource.data.keys().hasAll([
          'version',
          'billingMode',
          'requirePayment',
          'automaticSuspension',
          'monthlyPriceCents',
          'currency',
          'defaultTrialDays',
          'dueBusinessDay',
          'gracePeriodDays',
          'paymentMethod',
          'pixKey',
          'pixKeyType',
          'pixRecipientName',
          'holidayDates',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'version',
          'billingMode',
          'requirePayment',
          'automaticSuspension',
          'monthlyPriceCents',
          'currency',
          'defaultTrialDays',
          'dueBusinessDay',
          'gracePeriodDays',
          'paymentMethod',
          'pixKey',
          'pixKeyType',
          'pixRecipientName',
          'holidayDates',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.version == 'emprovex_billing_v1'
        && request.resource.data.billingMode in ['off', 'observe', 'enforce']
        && request.resource.data.requirePayment is bool
        && request.resource.data.automaticSuspension == false
        && request.resource.data.monthlyPriceCents is int
        && request.resource.data.monthlyPriceCents >= 0
        && request.resource.data.currency == 'BRL'
        && request.resource.data.defaultTrialDays is int
        && request.resource.data.defaultTrialDays >= 1
        && request.resource.data.defaultTrialDays <= 365
        && request.resource.data.dueBusinessDay == 5
        && request.resource.data.gracePeriodDays is int
        && request.resource.data.gracePeriodDays >= 0
        && request.resource.data.gracePeriodDays <= 90
        && request.resource.data.paymentMethod == 'pix_manual'
        && request.resource.data.pixKey is string
        && request.resource.data.pixKeyType in ['', 'cpf', 'cnpj', 'email', 'phone', 'random']
        && request.resource.data.pixRecipientName is string
        && request.resource.data.holidayDates is list
        && request.resource.data.holidayDates.size() <= 128
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string;
    }

    function validBillingAccount(workspaceId) {
      let workspace = workspaceData(workspaceId);
      return workspaceExists(workspaceId)
        && request.resource.data.keys().hasAll([
          'version',
          'workspaceId',
          'ug',
          'authorizedEmail',
          'status',
          'monthlyPriceCents',
          'currency',
          'trialGranted',
          'trialStartedAt',
          'trialEndsAt',
          'paymentRequired',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'version',
          'workspaceId',
          'ug',
          'authorizedEmail',
          'status',
          'monthlyPriceCents',
          'currency',
          'trialGranted',
          'trialStartedAt',
          'trialEndsAt',
          'paymentRequired',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && request.resource.data.version == 'emprovex_billing_v1'
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.ug == workspace.ug
        && request.resource.data.authorizedEmail == workspace.authorizedEmail
        && request.resource.data.status in [
          'trial',
          'active',
          'pending',
          'suspended',
          'canceled',
          'exempt'
        ]
        && request.resource.data.monthlyPriceCents is int
        && request.resource.data.monthlyPriceCents >= 0
        && request.resource.data.currency == 'BRL'
        && request.resource.data.trialGranted is bool
        && request.resource.data.trialStartedAt is string
        && request.resource.data.trialEndsAt is string
        && request.resource.data.paymentRequired is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string;
    }

    function validBillingAccountUpdate(workspaceId) {
      return validBillingAccount(workspaceId)
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.ug == resource.data.ug
        && request.resource.data.authorizedEmail == resource.data.authorizedEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function validBillingCycle(cycleId) {
      let workspaceId = request.resource.data.workspaceId;
      return request.resource.data.keys().hasAll([
          'version',
          'id',
          'workspaceId',
          'ug',
          'referenceMonth',
          'amountCents',
          'dueDate',
          'status',
          'confirmedAt',
          'confirmedBy',
          'note',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'version',
          'id',
          'workspaceId',
          'ug',
          'referenceMonth',
          'amountCents',
          'dueDate',
          'status',
          'confirmedAt',
          'confirmedBy',
          'note',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.version == 'emprovex_billing_v1'
        && request.resource.data.id == cycleId
        && workspaceId is string
        && workspaceExists(workspaceId)
        && request.resource.data.ug == workspaceData(workspaceId).ug
        && request.resource.data.referenceMonth is string
        && request.resource.data.referenceMonth.matches('^[0-9]{4}-[0-9]{2}
      return request.resource.data.keys().hasOnly(['currentNumber'])
        && request.resource.data.currentNumber is int
        && request.resource.data.currentNumber == 0;
    }

    function canAdminProvisionTermCounter(workspaceId) {
      let workspace = getAfter(
        /databases/$(database)/documents/workspaces/$(workspaceId)
      ).data;
      let account = getAfter(
        /databases/$(database)/documents/platformAccounts/$(workspace.authorizedEmail)
      ).data;

      return isPlatformAdmin()
        && workspace.id == workspaceId
        && workspace.status == 'active'
        && workspace.authorizedEmail is string
        && account.accountType == 'sector'
        && account.status == 'active'
        && account.workspaceId == workspaceId
        && account.email == workspace.authorizedEmail
        && 'ug' in workspace
        && 'ug' in account
        && isValidUnitUg(workspace.ug)
        && workspace.ug == account.ug
        && validInitialTermCounter();
    }

    function validOperationalTermCounterUpdate() {
      return request.resource.data.currentNumber is int
        && request.resource.data.currentNumber >= 0
        && resource.data.currentNumber is int
        && request.resource.data.currentNumber >= resource.data.currentNumber
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentNumber'
        ]);
    }

    function validWorkspaceDocumentStorage(workspaceId) {
      return request.resource.data.keys().hasAll([
          'provider',
          'status',
          'workspaceId',
          'accountEmail',
          'rootFolderId',
          'empenhosFolderId',
          'invoicesFolderId',
          'configuredAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'provider',
          'status',
          'workspaceId',
          'accountEmail',
          'rootFolderId',
          'empenhosFolderId',
          'invoicesFolderId',
          'configuredAt',
          'updatedAt'
        ])
        && request.resource.data.provider == 'google-drive'
        && request.resource.data.status == 'configured'
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.accountEmail == request.auth.token.email
        && request.resource.data.rootFolderId is string
        && request.resource.data.rootFolderId.size() > 5
        && request.resource.data.empenhosFolderId is string
        && request.resource.data.empenhosFolderId.size() > 5
        && request.resource.data.invoicesFolderId is string
        && request.resource.data.invoicesFolderId.size() > 5
        && request.resource.data.configuredAt is string
        && request.resource.data.updatedAt is string;
    }

    function validWorkspaceDocumentStorageUpdate(workspaceId) {
      return validWorkspaceDocumentStorage(workspaceId)
        && resource.data.provider == 'google-drive'
        && resource.data.workspaceId == workspaceId
        && resource.data.accountEmail == request.auth.token.email
        && request.resource.data.configuredAt == resource.data.configuredAt;
    }

    function isSagNsLockId(id) {
      return id.matches('^sagNsLock_.+');
    }

    function isValidNsNumber(value) {
      return value is string
        && value.matches('^[0-9]{4}NS[0-9]{6}$');
    }

    function isValidNsUg(value) {
      return isValidUnitUg(value);
    }

    function isValidCnpjShape(value) {
      return value is string
        && value.matches('^[0-9A-Z]{12}[0-9]{2}$');
    }

    function empenhoCnpjCreateIsValid(data) {
      return !('supplierCnpj' in data)
        || isValidCnpjShape(data.supplierCnpj);
    }

    function empenhoCnpjUpdateIsValid() {
      return !('supplierCnpj' in request.resource.data)
        || isValidCnpjShape(request.resource.data.supplierCnpj)
        || (
          'supplierCnpj' in resource.data
          && request.resource.data.supplierCnpj == resource.data.supplierCnpj
        );
    }

    function validEmpenhoRevisionCreate(data) {
      return data.keys().hasAll([
          'revision',
          'updatedAt',
          'updatedBy'
        ])
        && data.revision is int
        && data.revision == 1
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function validEmpenhoRevisionUpdate() {
      let currentRevision = 'revision' in resource.data
        ? resource.data.revision
        : 0;
      return currentRevision is int
        && currentRevision >= 0
        && request.resource.data.revision is int
        && request.resource.data.revision == currentRevision + 1
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() > 0
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function empenhoDeletionLockId(empenhoId) {
      return 'empenhoDelete_' + empenhoId;
    }

    function isEmpenhoDeletionLockId(id) {
      return id.matches('^empenhoDelete_.+$');
    }

    function empenhoDeletionIsLockedAfter(workspaceId, empenhoId) {
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(empenhoDeletionLockId(empenhoId));
      return empenhoId is string
        && existsAfter(lockPath);
    }

    function linkedEmpenhoWriteAllowedAfter(workspaceId, data) {
      return !('empenhoId' in data)
        || (
          data.empenhoId is string
          && !empenhoDeletionIsLockedAfter(workspaceId, data.empenhoId)
        );
    }

    function validEmpenhoDeletionLockCreate(workspaceId, id) {
      let empenhoId = request.resource.data.empenhoId;
      let empenhoPath = /databases/$(database)/documents/workspaces/$(workspaceId)/empenhos/$(empenhoId);
      return isEmpenhoDeletionLockId(id)
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'empenhoId',
          'correlationId',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'empenhoId',
          'correlationId',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.id == id
        && id == empenhoDeletionLockId(empenhoId)
        && request.resource.data.type == 'empenho-deletion-lock'
        && request.resource.data.workspaceId == workspaceId
        && empenhoId is string
        && empenhoId.size() > 0
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy == request.auth.uid
        && existsAfter(empenhoPath)
        && getAfter(empenhoPath).data.id == empenhoId;
    }

    function validEmpenhoDeletionLockDelete(workspaceId, id) {
      return isEmpenhoDeletionLockId(id)
        && resource.data.id == id
        && resource.data.type == 'empenho-deletion-lock'
        && resource.data.workspaceId == workspaceId
        && resource.data.createdBy == request.auth.uid;
    }

    function validEmpenhoLifecycleDelete(workspaceId, empenhoId) {
      let lockId = empenhoDeletionLockId(empenhoId);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return exists(lockPath)
        && get(lockPath).data.id == lockId
        && get(lockPath).data.type == 'empenho-deletion-lock'
        && get(lockPath).data.workspaceId == workspaceId
        && get(lockPath).data.empenhoId == empenhoId
        && get(lockPath).data.createdBy == request.auth.uid
        && !existsAfter(lockPath);
    }

    function invoiceHasControlledNs(data) {
      return 'numeroNS' in data
        && isValidNsNumber(data.numeroNS);
    }

    function invoiceHasCanonicalNsIdentity(data) {
      return invoiceHasControlledNs(data)
        && 'nsUg' in data
        && isValidNsUg(data.nsUg);
    }

    function invoiceHasLegacyNsIdentity(data) {
      return invoiceHasControlledNs(data)
        && !('nsUg' in data);
    }

    function invoiceNsFieldIsValid(data) {
      return (
          !('numeroNS' in data)
          && !('nsUg' in data)
        )
        || (
          isValidNsNumber(data.numeroNS)
          && (
            !('nsUg' in data)
            || isValidNsUg(data.nsUg)
          )
        );
    }

    function sagNsLockIdForIdentity(ug, numeroNS) {
      return 'sagNsLock_' + ug + '_' + numeroNS;
    }

    function legacySagNsLockIdForNumber(numeroNS) {
      return 'sagNsLock_' + numeroNS;
    }

    function invoiceEmpenhoMatchesAfter(workspaceId, data) {
      let empenhoPath = /databases/$(database)/documents/workspaces/$(workspaceId)/empenhos/$(data.empenhoId);
      return data.empenhoId is string
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(empenhoPath)
        && getAfter(empenhoPath).data.id == data.empenhoId
        && getAfter(empenhoPath).data.supplierCnpj == data.supplierCnpj;
    }

    function workspaceUgMatchesNs(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return (
          workspaceId == 'hgesm-aprov'
          && ug == '160416'
          && (
            !('ug' in workspace)
            || workspace.ug == '160416'
          )
        )
        || (
          'ug' in workspace
          && isValidUnitUg(workspace.ug)
          && workspace.ug == ug
        );
    }

    function canonicalInvoiceLockMatchesAfter(workspaceId, id, data) {
      let lockId = sagNsLockIdForIdentity(data.nsUg, data.numeroNS);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return invoiceHasCanonicalNsIdentity(data)
        && data.recordKey == id
        && data.id is string
        && data.id.size() > 0
        && data.empenhoId is string
        && data.empenhoId.size() > 0
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(lockPath)
        && getAfter(lockPath).data.id == lockId
        && getAfter(lockPath).data.type == 'sag-ns-lock'
        && getAfter(lockPath).data.workspaceId == workspaceId
        && getAfter(lockPath).data.ug == data.nsUg
        && getAfter(lockPath).data.numeroNS == data.numeroNS
        && getAfter(lockPath).data.invoiceRecordKey == id
        && getAfter(lockPath).data.invoiceId == data.id
        && getAfter(lockPath).data.empenhoId == data.empenhoId
        && getAfter(lockPath).data.supplierCnpj == data.supplierCnpj;
    }

    function legacyInvoiceLockMatchesAfter(workspaceId, id, data) {
      let lockId = legacySagNsLockIdForNumber(data.numeroNS);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return invoiceHasLegacyNsIdentity(data)
        && data.recordKey == id
        && data.id is string
        && data.id.size() > 0
        && data.empenhoId is string
        && data.empenhoId.size() > 0
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(lockPath)
        && getAfter(lockPath).data.id == lockId
        && getAfter(lockPath).data.type == 'sag-ns-lock'
        && getAfter(lockPath).data.workspaceId == workspaceId
        && !('ug' in getAfter(lockPath).data)
        && getAfter(lockPath).data.numeroNS == data.numeroNS
        && getAfter(lockPath).data.invoiceRecordKey == id
        && getAfter(lockPath).data.invoiceId == data.id
        && getAfter(lockPath).data.empenhoId == data.empenhoId
        && getAfter(lockPath).data.supplierCnpj == data.supplierCnpj;
    }

    function invoiceLockMatchesAfter(workspaceId, id, data) {
      return canonicalInvoiceLockMatchesAfter(workspaceId, id, data)
        || legacyInvoiceLockMatchesAfter(workspaceId, id, data);
    }

    function sameNsIdentityAfterUpdate() {
      return invoiceHasControlledNs(request.resource.data)
        && request.resource.data.numeroNS == resource.data.numeroNS
        && (
          (
            !('nsUg' in resource.data)
            && !('nsUg' in request.resource.data)
          )
          || (
            'nsUg' in resource.data
            && 'nsUg' in request.resource.data
            && request.resource.data.nsUg == resource.data.nsUg
          )
        );
    }

    function controlledOldInvoiceLockReleasedAfter(workspaceId, id) {
      let oldLockId = invoiceHasCanonicalNsIdentity(resource.data)
        ? sagNsLockIdForIdentity(resource.data.nsUg, resource.data.numeroNS)
        : legacySagNsLockIdForNumber(resource.data.numeroNS);
      let oldLockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(oldLockId);
      return sameNsIdentityAfterUpdate()
        || !existsAfter(oldLockPath)
        || getAfter(oldLockPath).data.invoiceRecordKey != id;
    }

    function oldInvoiceLockReleasedAfter(workspaceId, id) {
      return !invoiceHasControlledNs(resource.data)
        || controlledOldInvoiceLockReleasedAfter(workspaceId, id);
    }

    function controlledDeletedInvoiceLockReleasedAfter(workspaceId, id) {
      let oldLockId = invoiceHasCanonicalNsIdentity(resource.data)
        ? sagNsLockIdForIdentity(resource.data.nsUg, resource.data.numeroNS)
        : legacySagNsLockIdForNumber(resource.data.numeroNS);
      let oldLockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(oldLockId);
      return !existsAfter(oldLockPath)
        || getAfter(oldLockPath).data.invoiceRecordKey != id;
    }

    function deletedInvoiceLockReleasedAfter(workspaceId, id) {
      return !invoiceHasControlledNs(resource.data)
        || controlledDeletedInvoiceLockReleasedAfter(workspaceId, id);
    }

    function invoiceIdentityChanged() {
      return !('recordKey' in resource.data)
        || !('supplierCnpj' in resource.data)
        || request.resource.data.recordKey != resource.data.recordKey
        || request.resource.data.id != resource.data.id
        || request.resource.data.empenhoId != resource.data.empenhoId
        || request.resource.data.supplierCnpj != resource.data.supplierCnpj;
    }

    function invoiceNsIdentityChanged() {
      return !sameNsIdentityAfterUpdate();
    }

    function invoiceNeedsEmpenhoRevalidation() {
      return !invoiceHasControlledNs(resource.data)
        || invoiceNsIdentityChanged()
        || invoiceIdentityChanged();
    }

    function preservesLegacyNsIdentity() {
      return invoiceHasLegacyNsIdentity(resource.data)
        && invoiceHasLegacyNsIdentity(request.resource.data)
        && request.resource.data.numeroNS == resource.data.numeroNS;
    }

    function validInvoiceCreate(workspaceId, id) {
      return invoiceNsFieldIsValid(request.resource.data)
        && request.resource.data.empenhoId is string
        && !empenhoDeletionIsLockedAfter(workspaceId, request.resource.data.empenhoId)
        && (
          !invoiceHasControlledNs(request.resource.data)
          || (
            invoiceHasCanonicalNsIdentity(request.resource.data)
            && canonicalInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
            && invoiceEmpenhoMatchesAfter(workspaceId, request.resource.data)
          )
        );
    }

    function validInvoiceUpdate(workspaceId, id) {
      return invoiceNsFieldIsValid(request.resource.data)
        && oldInvoiceLockReleasedAfter(workspaceId, id)
        && (
          !invoiceHasControlledNs(request.resource.data)
          || (
            (
              (
                invoiceHasCanonicalNsIdentity(request.resource.data)
                && canonicalInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
              )
              || (
                preservesLegacyNsIdentity()
                && legacyInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
              )
            )
            && (
              !invoiceNeedsEmpenhoRevalidation()
              || invoiceEmpenhoMatchesAfter(workspaceId, request.resource.data)
            )
          )
        );
    }

    function validInvoiceDelete(workspaceId, id) {
      return deletedInvoiceLockReleasedAfter(workspaceId, id);
    }

    function sagNsLockTargetMatchesAfter(workspaceId) {
      let invoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return existsAfter(invoicePath)
        && getAfter(invoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(invoicePath).data.id == request.resource.data.invoiceId
        && getAfter(invoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(invoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(invoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && 'nsUg' in getAfter(invoicePath).data
            && getAfter(invoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(invoicePath).data)
          )
        );
    }

    function validSagNsLock(workspaceId, id) {
      return isSagNsLockId(id)
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'ug',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'ug',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == id
        && request.resource.data.id == sagNsLockIdForIdentity(
          request.resource.data.ug,
          request.resource.data.numeroNS
        )
        && request.resource.data.type == 'sag-ns-lock'
        && request.resource.data.workspaceId == workspaceId
        && isValidNsUg(request.resource.data.ug)
        && workspaceUgMatchesNs(workspaceId, request.resource.data.ug)
        && isValidNsNumber(request.resource.data.numeroNS)
        && request.resource.data.invoiceRecordKey is string
        && request.resource.data.invoiceRecordKey.size() > 0
        && request.resource.data.invoiceId is string
        && request.resource.data.invoiceId.size() > 0
        && request.resource.data.empenhoId is string
        && request.resource.data.empenhoId.size() > 0
        && isValidCnpjShape(request.resource.data.supplierCnpj)
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid
        && sagNsLockTargetMatchesAfter(workspaceId);
    }

    function validLegacySagNsLockUpdate(workspaceId, id) {
      return isSagNsLockId(id)
        && !('ug' in resource.data)
        && !('ug' in request.resource.data)
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == id
        && request.resource.data.id == legacySagNsLockIdForNumber(request.resource.data.numeroNS)
        && request.resource.data.type == 'sag-ns-lock'
        && request.resource.data.workspaceId == workspaceId
        && isValidNsNumber(request.resource.data.numeroNS)
        && request.resource.data.updatedBy == request.auth.uid
        && sagNsLockTargetMatchesAfter(workspaceId);
    }

    function sagNsLockOwnerUnchanged() {
      return resource.data.invoiceRecordKey == request.resource.data.invoiceRecordKey
        && resource.data.invoiceId == request.resource.data.invoiceId
        && resource.data.empenhoId == request.resource.data.empenhoId
        && resource.data.supplierCnpj == request.resource.data.supplierCnpj;
    }

    function validSagNsLockOwnerMigration(workspaceId) {
      let oldInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(resource.data.invoiceRecordKey);
      let newInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return resource.data.invoiceRecordKey != request.resource.data.invoiceRecordKey
        && !existsAfter(oldInvoicePath)
        && existsAfter(newInvoicePath)
        && getAfter(newInvoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(newInvoicePath).data.id == request.resource.data.invoiceId
        && getAfter(newInvoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(newInvoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(newInvoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && getAfter(newInvoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(newInvoicePath).data)
          )
        );
    }

    function validSagNsLockMetadataRefresh(workspaceId) {
      let ownerInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return resource.data.invoiceRecordKey == request.resource.data.invoiceRecordKey
        && existsAfter(ownerInvoicePath)
        && getAfter(ownerInvoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(ownerInvoicePath).data.id == request.resource.data.invoiceId
        && getAfter(ownerInvoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(ownerInvoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(ownerInvoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && getAfter(ownerInvoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(ownerInvoicePath).data)
          )
        );
    }

    function validSagNsLockDelete(workspaceId, id) {
      let ownerInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(resource.data.invoiceRecordKey);
      return isSagNsLockId(id)
        && resource.data.type == 'sag-ns-lock'
        && resource.data.workspaceId == workspaceId
        && (
          !existsAfter(ownerInvoicePath)
          || (
            existsAfter(ownerInvoicePath)
            && (
              !('numeroNS' in getAfter(ownerInvoicePath).data)
              || getAfter(ownerInvoicePath).data.numeroNS != resource.data.numeroNS
              || (
                'ug' in resource.data
                && (
                  !('nsUg' in getAfter(ownerInvoicePath).data)
                  || getAfter(ownerInvoicePath).data.nsUg != resource.data.ug
                )
              )
              || (
                !('ug' in resource.data)
                && 'nsUg' in getAfter(ownerInvoicePath).data
              )
            )
          )
        );
    }

    function validSagNsLockUpdate(workspaceId, id) {
      return (
          (
            'ug' in resource.data
            && validSagNsLock(workspaceId, id)
            && resource.data.ug == request.resource.data.ug
          )
          || (
            !('ug' in resource.data)
            && validLegacySagNsLockUpdate(workspaceId, id)
          )
        )
        && resource.data.id == request.resource.data.id
        && resource.data.type == request.resource.data.type
        && resource.data.workspaceId == request.resource.data.workspaceId
        && resource.data.numeroNS == request.resource.data.numeroNS
        && resource.data.createdAt == request.resource.data.createdAt
        && (
          sagNsLockOwnerUnchanged()
          || validSagNsLockMetadataRefresh(workspaceId)
          || validSagNsLockOwnerMigration(workspaceId)
        );
    }

    function isSelfPlatformAccount() {
      return isVerifiedUser()
        && resource.data.accountType == 'sector'
        && identityMatchesAccount(resource.data);
    }

    function selfAccountImmutableFieldsPreserved(accountId) {
      return request.resource.data.email == resource.data.email
        && request.resource.data.email == accountId
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.workspaceId == resource.data.workspaceId
        && (
          (
            !('ug' in resource.data)
            && !('ug' in request.resource.data)
          )
          || (
            'ug' in resource.data
            && 'ug' in request.resource.data
            && request.resource.data.ug == resource.data.ug
          )
        )
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function selfAccountWorkspaceIsActive(accountId) {
      return resource.data.workspaceId is string
        && exists(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        )
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.id == resource.data.workspaceId
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.authorizedEmail == accountId
        && (
          (
            !('ug' in resource.data)
            && !('ug' in get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data)
          )
          || (
            'ug' in resource.data
            && 'ug' in get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data
            && resource.data.ug == get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data.ug
          )
        );
    }

    function isSelfUidBinding(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && !hasBoundUid(resource.data)
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firstLoginAt is string
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firebaseUid',
          'firstLoginAt',
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isSelfPreboundFirstLogin(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && hasBoundUid(resource.data)
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && !('firstLoginAt' in resource.data)
        && request.resource.data.firstLoginAt is string
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstLoginAt',
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isSelfBoundSessionRefresh(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && hasBoundUid(resource.data)
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.firstLoginAt == resource.data.firstLoginAt
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isValidAuditOperation(operation) {
      return operation in [
        'ns.assign',
        'ns.replace',
        'ns.remove',
        'invoice.identity_migrate',
        'invoice.delete',
        'invoice.bulk_delete',
        'empenho.delete',
        'supplier_cnpj.migrate',
        'sector.create',
        'sector.profile_update',
        'sector.status_change',
        'sector.ug_backfill',
        'sector.password_reset',
        'sector.delete',
        'session.terminate',
        'billing.config_update',
        'billing.trial_grant',
        'billing.status_change',
        'billing.payment_confirm',
        'billing.payment_reopen',
        'historical.repair'
      ];
    }

    function isValidAuditSource(source) {
      return source in ['sag', 'manual', 'migration', 'system', 'admin'];
    }

    function isValidAuditEntityType(entityType) {
      return entityType in [
        'invoice',
        'invoice_batch',
        'empenho',
        'workspace',
        'session',
        'billing_config',
        'billing_account',
        'billing_cycle',
        'ns_lock'
      ];
    }

    function auditUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return (
          workspaceId == 'hgesm-aprov'
          && ug == '160416'
          && (
            !('ug' in workspace)
            || workspace.ug == '160416'
          )
        )
        || (
          ug == null
          && !('ug' in workspace)
        )
        || (
          ug is string
          && 'ug' in workspace
          && workspace.ug == ug
          && isValidUnitUg(ug)
        );
    }

    function validAuditEventShape(eventId, workspaceId) {
      return request.resource.data.keys().hasAll([
          'eventVersion',
          'eventId',
          'workspaceId',
          'ug',
          'operation',
          'source',
          'entityType',
          'entityId',
          'correlationId',
          'actorUid',
          'actorEmail',
          'before',
          'after',
          'metadata',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'eventVersion',
          'eventId',
          'workspaceId',
          'ug',
          'operation',
          'source',
          'entityType',
          'entityId',
          'correlationId',
          'actorUid',
          'actorEmail',
          'before',
          'after',
          'metadata',
          'createdAt'
        ])
        && request.resource.data.eventVersion == 'emprovex_audit_v1'
        && request.resource.data.eventId == eventId
        && request.resource.data.workspaceId == workspaceId
        && isValidAuditOperation(request.resource.data.operation)
        && isValidAuditSource(request.resource.data.source)
        && isValidAuditEntityType(request.resource.data.entityType)
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() > 0
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.before is map
        && request.resource.data.after is map
        && request.resource.data.metadata is map
        && request.resource.data.createdAt == request.time;
    }

    function validWorkspaceAuditEvent(eventId, workspaceId) {
      return validAuditEventShape(eventId, workspaceId)
        && auditUgMatchesWorkspace(workspaceId, request.resource.data.ug);
    }

    function validPlatformAuditEvent(eventId) {
      return isPlatformAdmin()
        && validAuditEventShape(
          eventId,
          request.resource.data.workspaceId
        )
        && request.resource.data.source == 'admin'
        && request.resource.data.operation in [
          'sector.create',
          'sector.profile_update',
          'sector.status_change',
          'sector.ug_backfill',
          'sector.password_reset',
          'sector.delete',
          'session.terminate',
          'billing.config_update',
          'billing.trial_grant',
          'billing.status_change',
          'billing.payment_confirm',
          'billing.payment_reopen'
        ];
    }

    function backupUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return isValidUnitUg(ug)
        && (
          (
            workspaceId == 'hgesm-aprov'
            && ug == '160416'
            && (
              !('ug' in workspace)
              || workspace.ug == '160416'
            )
          )
          || (
            'ug' in workspace
            && isValidUnitUg(workspace.ug)
            && workspace.ug == ug
          )
        );
    }

    function validWorkspaceBackupStatus(workspaceId) {
      return canAccessWorkspace(workspaceId)
        && request.resource.data.keys().hasAll([
          'workspaceId',
          'ug',
          'accountEmail',
          'status',
          'lastAttemptAt',
          'lastSuccessAt',
          'latestFileId',
          'latestFileName',
          'sizeBytes',
          'recordCount',
          'schemaVersion',
          'sha256',
          'trigger',
          'lastError',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'workspaceId',
          'ug',
          'accountEmail',
          'status',
          'lastAttemptAt',
          'lastSuccessAt',
          'latestFileId',
          'latestFileName',
          'sizeBytes',
          'recordCount',
          'schemaVersion',
          'sha256',
          'trigger',
          'lastError',
          'updatedBy'
        ])
        && request.resource.data.workspaceId == workspaceId
        && backupUgMatchesWorkspace(workspaceId, request.resource.data.ug)
        && request.resource.data.accountEmail == request.auth.token.email
        && request.resource.data.status in ['success', 'failed', 'in_progress']
        && request.resource.data.lastAttemptAt is string
        && request.resource.data.lastSuccessAt is string
        && request.resource.data.latestFileId is string
        && request.resource.data.latestFileName is string
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes >= 0
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount >= 0
        && request.resource.data.schemaVersion == 1
        && request.resource.data.sha256 is string
        && request.resource.data.trigger in ['automatic', 'manual']
        && request.resource.data.lastError is string
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Diretório administrativo da plataforma. O administrador pode listar e
    // manter metadados, mas não recebe acesso operacional aos workspaces externos.
    match /workspaces/{workspaceId} {
      allow get: if isPlatformAdmin()
        || canReadWorkspaceMetadataFromResource(workspaceId);
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validWorkspaceCreate(workspaceId)
        && workspaceHasMatchingAccountAfterWrite(workspaceId);
      allow update: if isPlatformAdmin()
        && workspaceId != 'hgesm-aprov'
        && validWorkspaceAdminUpdate(workspaceId)
        && workspaceHasMatchingAccountAfterWrite(workspaceId);
      allow delete: if false;
    }

    match /platformAccounts/{accountId} {
      allow get: if isPlatformAdmin() || isSelfPlatformAccount();
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validSectorAccountCreate(accountId)
        && accountHasMatchingWorkspaceAfterWrite(accountId);
      allow update: if (
          isPlatformAdmin()
          && accountId != 'aprov1hgesm@gmail.com'
          && validSectorAccountAdminUpdate(accountId)
          && accountHasMatchingWorkspaceAfterWrite(accountId)
        )
        || isSelfUidBinding(accountId)
        || isSelfPreboundFirstLogin(accountId)
        || isSelfBoundSessionRefresh(accountId);
      allow delete: if false;
    }

    // Bloco 22 — Billing em modo de observação. Apenas a administração escreve.
    // O setor pode ler somente o seu próprio resumo comercial; nenhuma regra de
    // acesso operacional depende destes documentos nesta fase.
    match /platformBillingConfig/{configId} {
      allow get, list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin()
        && configId == 'main'
        && validPlatformBillingConfig();
      allow delete: if false;
    }

    match /billingAccounts/{workspaceId} {
      allow get: if isPlatformAdmin() || canAccessWorkspace(workspaceId);
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validBillingAccount(workspaceId);
      allow update: if isPlatformAdmin()
        && validBillingAccountUpdate(workspaceId);
      allow delete: if false;
    }

    match /billingCycles/{cycleId} {
      allow get, list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validBillingCycle(cycleId);
      allow update: if isPlatformAdmin()
        && validBillingCycleUpdate(cycleId);
      allow delete: if false;
    }

    match /platformAuditEvents/{eventId} {
      allow get, list: if isPlatformAdmin();
      allow create: if validPlatformAuditEvent(eventId);
      allow update, delete: if false;
    }

    match /platformUgIndex/{ug} {
      allow get, list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly([
          'ug',
          'workspaceId',
          'email',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.ug == ug
        && isValidUnitUg(ug)
        && request.resource.data.workspaceId is string
        && request.resource.data.email is string
        && existsAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        )
        && existsAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        )
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.ug == ug
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.authorizedEmail == request.resource.data.email
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        ).data.ug == ug
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        ).data.workspaceId == request.resource.data.workspaceId;
      allow update, delete: if false;
    }

    // Commercial readiness — metadados de backup. O fundador enxerga apenas
    // saúde/telemetria; o conteúdo operacional continua tenant-scoped.
    match /workspaceBackupStatus/{workspaceId} {
      allow get: if isPlatformAdmin() || canAccessWorkspace(workspaceId);
      allow list: if isPlatformAdmin();
      allow create, update: if validWorkspaceBackupStatus(workspaceId);
      allow delete: if false;
    }

    // Metadados do backup global de identidade. Nunca contém hashes/senhas.
    match /platformRecoveryStatus/{id} {
      allow get, list, create, update: if isPlatformAdmin();
      allow delete: if false;
    }

    // Block 16.2 — collection-group read used only by the founder dashboard.
    // This recursive match grants no writes and no access to external sectors.
    match /{path=**}/sessionSlots/{slotId} {
      allow get, list: if isPlatformAdmin();
    }

    // Block 16.2 — collection-group queries require a recursive match. This
    // grants only global LIST to the platform admin; no create/update/delete
    // permission is introduced here and sector users receive no access.
    match /{sessionSlotPath=**}/sessionSlots/{slotId} {
      allow list: if isPlatformAdmin();
    }

    // Block 16.1 — capacity metadata. These two fixed slots enforce a maximum of
    // two simultaneous external-sector browser sessions without query/count races.
    // The founder is exempt and never claims a slot.
    match /workspaces/{workspaceId}/sessionSlots/{slotId} {
      allow get, list: if canAccessWorkspace(workspaceId) || isPlatformAdmin();
      allow create: if validWorkspaceSessionLeaseCreate(workspaceId, slotId);
      allow update: if validWorkspaceSessionLeaseUpdate(workspaceId, slotId);
      allow delete: if validWorkspaceSessionLeaseDelete(workspaceId, slotId)
        || validAdminSessionSlotDelete(workspaceId, slotId);
    }

    // Block 16.2 — tombstones curtos impedem uma sessão encerrada remotamente
    // de recriar o slot com o mesmo sessionId.
    match /workspaces/{workspaceId}/sessionRevocations/{sessionId} {
      // O cliente precisa poder consultar um sessionId que normalmente ainda não
      // existe. Por isso o GET é tenant-scoped pelo workspace, sem depender de
      // resource.data; LIST continua exclusivo da administração.
      allow get: if isPlatformAdmin() || canAccessWorkspace(workspaceId);
      allow list: if isPlatformAdmin();
      allow create: if validSessionRevocationCreate(workspaceId, sessionId);
      allow update, delete: if false;
    }

    // Histórico global de cota/faturamento: escrito exclusivamente pelo servidor
    // via IAM e somente legível pela conta fundadora. Clientes jamais podem forjar
    // a série histórica usada nos relatórios administrativos.
    match /platformUsageHistory/{dayKey} {
      allow get, list: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // Block 16.3 — low-frequency workspace usage estimates. Sector clients can
    // only append monotonically to their own UG counters; only the founder can read.
    match /workspaces/{workspaceId}/usageEstimates/{dayKey} {
      allow get, list: if isPlatformAdmin();
      allow create: if validWorkspaceUsageEstimateCreate(workspaceId, dayKey);
      allow update: if validWorkspaceUsageEstimateUpdate(workspaceId, dayKey);
      allow delete: if false;
    }

    function validHomeSnapshotNumber(value) {
      return value is number && value >= 0;
    }

    function homeSnapshotUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return isValidUnitUg(ug)
        && (
          (
            workspaceId == 'hgesm-aprov'
            && ug == '160416'
            && (
              !('ug' in workspace)
              || workspace.ug == '160416'
            )
          )
          || (
            'ug' in workspace
            && isValidUnitUg(workspace.ug)
            && workspace.ug == ug
          )
        );
    }

    function validHomeSnapshot(workspaceId) {
      return canAccessWorkspace(workspaceId)
        && request.resource.data.keys().hasAll([
          'snapshotVersion',
          'workspaceId',
          'ug',
          'contentHash',
          'generatedAt',
          'generatedBy',
          'metrics',
          'alerts',
          'receiving',
          'execution',
          'classStats',
          'stars'
        ])
        && request.resource.data.keys().hasOnly([
          'snapshotVersion',
          'workspaceId',
          'ug',
          'contentHash',
          'generatedAt',
          'generatedBy',
          'metrics',
          'alerts',
          'receiving',
          'execution',
          'classStats',
          'stars'
        ])
        && request.resource.data.snapshotVersion == 'emprovex_home_snapshot_v1'
        && request.resource.data.workspaceId == workspaceId
        && homeSnapshotUgMatchesWorkspace(workspaceId, request.resource.data.ug)
        && request.resource.data.contentHash is string
        && request.resource.data.contentHash.matches('^[0-9a-f]{8}$')
        && request.resource.data.generatedAt is string
        && request.resource.data.generatedAt.size() > 10
        && request.resource.data.generatedBy == request.auth.uid
        && request.resource.data.metrics is map
        && request.resource.data.metrics.keys().hasOnly([
          'totalEmpenhos',
          'totalValue'
        ])
        && validHomeSnapshotNumber(request.resource.data.metrics.totalEmpenhos)
        && validHomeSnapshotNumber(request.resource.data.metrics.totalValue)
        && request.resource.data.alerts is map
        && request.resource.data.alerts.keys().hasOnly([
          'total',
          'critical',
          'attention'
        ])
        && validHomeSnapshotNumber(request.resource.data.alerts.total)
        && validHomeSnapshotNumber(request.resource.data.alerts.critical)
        && validHomeSnapshotNumber(request.resource.data.alerts.attention)
        && request.resource.data.receiving is map
        && request.resource.data.receiving.keys().hasOnly([
          'pendingEmpenhos',
          'pendingItems',
          'balance'
        ])
        && validHomeSnapshotNumber(request.resource.data.receiving.pendingEmpenhos)
        && validHomeSnapshotNumber(request.resource.data.receiving.pendingItems)
        && validHomeSnapshotNumber(request.resource.data.receiving.balance)
        && request.resource.data.execution is map
        && request.resource.data.execution.keys().hasOnly([
          'committed',
          'received',
          'percentage'
        ])
        && validHomeSnapshotNumber(request.resource.data.execution.committed)
        && validHomeSnapshotNumber(request.resource.data.execution.received)
        && validHomeSnapshotNumber(request.resource.data.execution.percentage)
        && request.resource.data.execution.percentage <= 100
        && request.resource.data.classStats is list
        && request.resource.data.classStats.size() <= 32
        && request.resource.data.stars is list
        && request.resource.data.stars.size() <= 72;
    }

    // Workspace-scoped operational data. There is deliberately no admin bypass:
    // a platform administrator cannot read another sector's operational records.
    match /workspaces/{workspaceId}/auditEvents/{eventId} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validWorkspaceAuditEvent(eventId, workspaceId);
      allow update, delete: if false;
    }

    match /workspaces/{workspaceId}/empenhos/{id} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validEmpenhoRevisionCreate(request.resource.data)
        && empenhoCnpjCreateIsValid(request.resource.data);
      allow update: if canAccessWorkspace(workspaceId)
        && !empenhoDeletionIsLockedAfter(workspaceId, id)
        && validEmpenhoRevisionUpdate()
        && empenhoCnpjUpdateIsValid();
      allow delete: if canAccessWorkspace(workspaceId)
        && validEmpenhoLifecycleDelete(workspaceId, id);
    }

    match /workspaces/{workspaceId}/alerts/{id} {
      allow read, delete: if canAccessWorkspace(workspaceId);
      allow create, update: if canAccessWorkspace(workspaceId)
        && linkedEmpenhoWriteAllowedAfter(workspaceId, request.resource.data);
    }

    match /workspaces/{workspaceId}/invoices/{id} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validInvoiceCreate(workspaceId, id);
      allow update: if canAccessWorkspace(workspaceId)
        && validInvoiceUpdate(workspaceId, id);
      allow delete: if canAccessWorkspace(workspaceId)
        && validInvoiceDelete(workspaceId, id);
    }

    match /workspaces/{workspaceId}/comissoes/{id} {
      allow read, write: if canAccessWorkspace(workspaceId);
    }

    match /workspaces/{workspaceId}/cronogramas/{id} {
      allow read, delete: if canAccessWorkspace(workspaceId);
      allow create, update: if canAccessWorkspace(workspaceId)
        && linkedEmpenhoWriteAllowedAfter(workspaceId, request.resource.data);
    }

    // Block 19.10 — snapshot econômico do Início.
    // Um único documento derivado alimenta a Home; ele não concede autorização
    // e nunca substitui as coleções operacionais como fonte de verdade.
    match /workspaces/{workspaceId}/settings/homeSnapshot {
      allow read: if canAccessWorkspace(workspaceId);
      allow create, update: if validHomeSnapshot(workspaceId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/termoRecebimentoCounter {
      // O cadastro administrativo verifica se existe contador residual antes de
      // provisionar um workspace novo. Essa leitura prévia só é permitida enquanto
      // o workspace ainda não existe; depois da criação, o administrador volta a
      // não possuir acesso ao contador operacional do tenant.
      allow read: if canAccessWorkspace(workspaceId)
        || (
          isPlatformAdmin()
          && !workspaceExists(workspaceId)
        );
      allow create: if canAdminProvisionTermCounter(workspaceId)
        || (
          canAccessWorkspace(workspaceId)
          && validInitialTermCounter()
        );
      allow update: if canAccessWorkspace(workspaceId)
        && validOperationalTermCounterUpdate();
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/documentStorage {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validWorkspaceDocumentStorage(workspaceId);
      allow update: if canAccessWorkspace(workspaceId)
        && validWorkspaceDocumentStorageUpdate(workspaceId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/{id} {
      // Listagem é limitada ao próprio workspace autenticado. Os settings atuais
      // já são individualmente legíveis pelo setor; o list habilita diagnósticos
      // de integridade sem ampliar acesso entre tenants.
      allow list: if canAccessWorkspace(workspaceId);
      allow get: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId);
      allow create: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && (
          (
            isEmpenhoDeletionLockId(id)
            && validEmpenhoDeletionLockCreate(workspaceId, id)
          )
          || (
            !isEmpenhoDeletionLockId(id)
            && (
              !isSagNsLockId(id)
              || validSagNsLock(workspaceId, id)
            )
          )
        );
      allow update: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && !isEmpenhoDeletionLockId(id)
        && (
          !isSagNsLockId(id)
          || validSagNsLockUpdate(workspaceId, id)
        );
      allow delete: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && (
          (
            isEmpenhoDeletionLockId(id)
            && validEmpenhoDeletionLockDelete(workspaceId, id)
          )
          || (
            !isEmpenhoDeletionLockId(id)
            && (
              !isSagNsLockId(id)
              || validSagNsLockDelete(workspaceId, id)
            )
          )
        );
    }

    // Bloco 13 — compatibilidade legada somente leitura.
    // O runtime oficial já usa /workspaces/hgesm-aprov/...; os dados raiz ficam
    // preservados apenas para consulta, auditoria e recuperação controlada.
    // Qualquer rollback com escrita exige mudança explícita de Rules, evitando que
    // uma simples regressão de frontend volte silenciosamente a gravar no legado.
    match /empenhos/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /alerts/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /invoices/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /comissoes/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /cronogramas/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    // A identidade visual global precisa continuar disponível antes do login.
    // A marca institucional é imutável no runtime: qualquer troca futura exige
    // manutenção deliberada fora da aplicação e revisão explícita destas Rules.
    match /settings/global {
      allow read: if true;
      allow write: if false;
    }

    // Demais settings raiz (incluindo o contador histórico) ficam somente leitura.
    match /settings/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }
  }
}
)
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 0
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}
      return request.resource.data.keys().hasOnly(['currentNumber'])
        && request.resource.data.currentNumber is int
        && request.resource.data.currentNumber == 0;
    }

    function canAdminProvisionTermCounter(workspaceId) {
      let workspace = getAfter(
        /databases/$(database)/documents/workspaces/$(workspaceId)
      ).data;
      let account = getAfter(
        /databases/$(database)/documents/platformAccounts/$(workspace.authorizedEmail)
      ).data;

      return isPlatformAdmin()
        && workspace.id == workspaceId
        && workspace.status == 'active'
        && workspace.authorizedEmail is string
        && account.accountType == 'sector'
        && account.status == 'active'
        && account.workspaceId == workspaceId
        && account.email == workspace.authorizedEmail
        && 'ug' in workspace
        && 'ug' in account
        && isValidUnitUg(workspace.ug)
        && workspace.ug == account.ug
        && validInitialTermCounter();
    }

    function validOperationalTermCounterUpdate() {
      return request.resource.data.currentNumber is int
        && request.resource.data.currentNumber >= 0
        && resource.data.currentNumber is int
        && request.resource.data.currentNumber >= resource.data.currentNumber
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentNumber'
        ]);
    }

    function validWorkspaceDocumentStorage(workspaceId) {
      return request.resource.data.keys().hasAll([
          'provider',
          'status',
          'workspaceId',
          'accountEmail',
          'rootFolderId',
          'empenhosFolderId',
          'invoicesFolderId',
          'configuredAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'provider',
          'status',
          'workspaceId',
          'accountEmail',
          'rootFolderId',
          'empenhosFolderId',
          'invoicesFolderId',
          'configuredAt',
          'updatedAt'
        ])
        && request.resource.data.provider == 'google-drive'
        && request.resource.data.status == 'configured'
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.accountEmail == request.auth.token.email
        && request.resource.data.rootFolderId is string
        && request.resource.data.rootFolderId.size() > 5
        && request.resource.data.empenhosFolderId is string
        && request.resource.data.empenhosFolderId.size() > 5
        && request.resource.data.invoicesFolderId is string
        && request.resource.data.invoicesFolderId.size() > 5
        && request.resource.data.configuredAt is string
        && request.resource.data.updatedAt is string;
    }

    function validWorkspaceDocumentStorageUpdate(workspaceId) {
      return validWorkspaceDocumentStorage(workspaceId)
        && resource.data.provider == 'google-drive'
        && resource.data.workspaceId == workspaceId
        && resource.data.accountEmail == request.auth.token.email
        && request.resource.data.configuredAt == resource.data.configuredAt;
    }

    function isSagNsLockId(id) {
      return id.matches('^sagNsLock_.+');
    }

    function isValidNsNumber(value) {
      return value is string
        && value.matches('^[0-9]{4}NS[0-9]{6}$');
    }

    function isValidNsUg(value) {
      return isValidUnitUg(value);
    }

    function isValidCnpjShape(value) {
      return value is string
        && value.matches('^[0-9A-Z]{12}[0-9]{2}$');
    }

    function empenhoCnpjCreateIsValid(data) {
      return !('supplierCnpj' in data)
        || isValidCnpjShape(data.supplierCnpj);
    }

    function empenhoCnpjUpdateIsValid() {
      return !('supplierCnpj' in request.resource.data)
        || isValidCnpjShape(request.resource.data.supplierCnpj)
        || (
          'supplierCnpj' in resource.data
          && request.resource.data.supplierCnpj == resource.data.supplierCnpj
        );
    }

    function validEmpenhoRevisionCreate(data) {
      return data.keys().hasAll([
          'revision',
          'updatedAt',
          'updatedBy'
        ])
        && data.revision is int
        && data.revision == 1
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function validEmpenhoRevisionUpdate() {
      let currentRevision = 'revision' in resource.data
        ? resource.data.revision
        : 0;
      return currentRevision is int
        && currentRevision >= 0
        && request.resource.data.revision is int
        && request.resource.data.revision == currentRevision + 1
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() > 0
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function empenhoDeletionLockId(empenhoId) {
      return 'empenhoDelete_' + empenhoId;
    }

    function isEmpenhoDeletionLockId(id) {
      return id.matches('^empenhoDelete_.+$');
    }

    function empenhoDeletionIsLockedAfter(workspaceId, empenhoId) {
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(empenhoDeletionLockId(empenhoId));
      return empenhoId is string
        && existsAfter(lockPath);
    }

    function linkedEmpenhoWriteAllowedAfter(workspaceId, data) {
      return !('empenhoId' in data)
        || (
          data.empenhoId is string
          && !empenhoDeletionIsLockedAfter(workspaceId, data.empenhoId)
        );
    }

    function validEmpenhoDeletionLockCreate(workspaceId, id) {
      let empenhoId = request.resource.data.empenhoId;
      let empenhoPath = /databases/$(database)/documents/workspaces/$(workspaceId)/empenhos/$(empenhoId);
      return isEmpenhoDeletionLockId(id)
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'empenhoId',
          'correlationId',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'empenhoId',
          'correlationId',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.id == id
        && id == empenhoDeletionLockId(empenhoId)
        && request.resource.data.type == 'empenho-deletion-lock'
        && request.resource.data.workspaceId == workspaceId
        && empenhoId is string
        && empenhoId.size() > 0
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy == request.auth.uid
        && existsAfter(empenhoPath)
        && getAfter(empenhoPath).data.id == empenhoId;
    }

    function validEmpenhoDeletionLockDelete(workspaceId, id) {
      return isEmpenhoDeletionLockId(id)
        && resource.data.id == id
        && resource.data.type == 'empenho-deletion-lock'
        && resource.data.workspaceId == workspaceId
        && resource.data.createdBy == request.auth.uid;
    }

    function validEmpenhoLifecycleDelete(workspaceId, empenhoId) {
      let lockId = empenhoDeletionLockId(empenhoId);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return exists(lockPath)
        && get(lockPath).data.id == lockId
        && get(lockPath).data.type == 'empenho-deletion-lock'
        && get(lockPath).data.workspaceId == workspaceId
        && get(lockPath).data.empenhoId == empenhoId
        && get(lockPath).data.createdBy == request.auth.uid
        && !existsAfter(lockPath);
    }

    function invoiceHasControlledNs(data) {
      return 'numeroNS' in data
        && isValidNsNumber(data.numeroNS);
    }

    function invoiceHasCanonicalNsIdentity(data) {
      return invoiceHasControlledNs(data)
        && 'nsUg' in data
        && isValidNsUg(data.nsUg);
    }

    function invoiceHasLegacyNsIdentity(data) {
      return invoiceHasControlledNs(data)
        && !('nsUg' in data);
    }

    function invoiceNsFieldIsValid(data) {
      return (
          !('numeroNS' in data)
          && !('nsUg' in data)
        )
        || (
          isValidNsNumber(data.numeroNS)
          && (
            !('nsUg' in data)
            || isValidNsUg(data.nsUg)
          )
        );
    }

    function sagNsLockIdForIdentity(ug, numeroNS) {
      return 'sagNsLock_' + ug + '_' + numeroNS;
    }

    function legacySagNsLockIdForNumber(numeroNS) {
      return 'sagNsLock_' + numeroNS;
    }

    function invoiceEmpenhoMatchesAfter(workspaceId, data) {
      let empenhoPath = /databases/$(database)/documents/workspaces/$(workspaceId)/empenhos/$(data.empenhoId);
      return data.empenhoId is string
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(empenhoPath)
        && getAfter(empenhoPath).data.id == data.empenhoId
        && getAfter(empenhoPath).data.supplierCnpj == data.supplierCnpj;
    }

    function workspaceUgMatchesNs(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return (
          workspaceId == 'hgesm-aprov'
          && ug == '160416'
          && (
            !('ug' in workspace)
            || workspace.ug == '160416'
          )
        )
        || (
          'ug' in workspace
          && isValidUnitUg(workspace.ug)
          && workspace.ug == ug
        );
    }

    function canonicalInvoiceLockMatchesAfter(workspaceId, id, data) {
      let lockId = sagNsLockIdForIdentity(data.nsUg, data.numeroNS);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return invoiceHasCanonicalNsIdentity(data)
        && data.recordKey == id
        && data.id is string
        && data.id.size() > 0
        && data.empenhoId is string
        && data.empenhoId.size() > 0
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(lockPath)
        && getAfter(lockPath).data.id == lockId
        && getAfter(lockPath).data.type == 'sag-ns-lock'
        && getAfter(lockPath).data.workspaceId == workspaceId
        && getAfter(lockPath).data.ug == data.nsUg
        && getAfter(lockPath).data.numeroNS == data.numeroNS
        && getAfter(lockPath).data.invoiceRecordKey == id
        && getAfter(lockPath).data.invoiceId == data.id
        && getAfter(lockPath).data.empenhoId == data.empenhoId
        && getAfter(lockPath).data.supplierCnpj == data.supplierCnpj;
    }

    function legacyInvoiceLockMatchesAfter(workspaceId, id, data) {
      let lockId = legacySagNsLockIdForNumber(data.numeroNS);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return invoiceHasLegacyNsIdentity(data)
        && data.recordKey == id
        && data.id is string
        && data.id.size() > 0
        && data.empenhoId is string
        && data.empenhoId.size() > 0
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(lockPath)
        && getAfter(lockPath).data.id == lockId
        && getAfter(lockPath).data.type == 'sag-ns-lock'
        && getAfter(lockPath).data.workspaceId == workspaceId
        && !('ug' in getAfter(lockPath).data)
        && getAfter(lockPath).data.numeroNS == data.numeroNS
        && getAfter(lockPath).data.invoiceRecordKey == id
        && getAfter(lockPath).data.invoiceId == data.id
        && getAfter(lockPath).data.empenhoId == data.empenhoId
        && getAfter(lockPath).data.supplierCnpj == data.supplierCnpj;
    }

    function invoiceLockMatchesAfter(workspaceId, id, data) {
      return canonicalInvoiceLockMatchesAfter(workspaceId, id, data)
        || legacyInvoiceLockMatchesAfter(workspaceId, id, data);
    }

    function sameNsIdentityAfterUpdate() {
      return invoiceHasControlledNs(request.resource.data)
        && request.resource.data.numeroNS == resource.data.numeroNS
        && (
          (
            !('nsUg' in resource.data)
            && !('nsUg' in request.resource.data)
          )
          || (
            'nsUg' in resource.data
            && 'nsUg' in request.resource.data
            && request.resource.data.nsUg == resource.data.nsUg
          )
        );
    }

    function controlledOldInvoiceLockReleasedAfter(workspaceId, id) {
      let oldLockId = invoiceHasCanonicalNsIdentity(resource.data)
        ? sagNsLockIdForIdentity(resource.data.nsUg, resource.data.numeroNS)
        : legacySagNsLockIdForNumber(resource.data.numeroNS);
      let oldLockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(oldLockId);
      return sameNsIdentityAfterUpdate()
        || !existsAfter(oldLockPath)
        || getAfter(oldLockPath).data.invoiceRecordKey != id;
    }

    function oldInvoiceLockReleasedAfter(workspaceId, id) {
      return !invoiceHasControlledNs(resource.data)
        || controlledOldInvoiceLockReleasedAfter(workspaceId, id);
    }

    function controlledDeletedInvoiceLockReleasedAfter(workspaceId, id) {
      let oldLockId = invoiceHasCanonicalNsIdentity(resource.data)
        ? sagNsLockIdForIdentity(resource.data.nsUg, resource.data.numeroNS)
        : legacySagNsLockIdForNumber(resource.data.numeroNS);
      let oldLockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(oldLockId);
      return !existsAfter(oldLockPath)
        || getAfter(oldLockPath).data.invoiceRecordKey != id;
    }

    function deletedInvoiceLockReleasedAfter(workspaceId, id) {
      return !invoiceHasControlledNs(resource.data)
        || controlledDeletedInvoiceLockReleasedAfter(workspaceId, id);
    }

    function invoiceIdentityChanged() {
      return !('recordKey' in resource.data)
        || !('supplierCnpj' in resource.data)
        || request.resource.data.recordKey != resource.data.recordKey
        || request.resource.data.id != resource.data.id
        || request.resource.data.empenhoId != resource.data.empenhoId
        || request.resource.data.supplierCnpj != resource.data.supplierCnpj;
    }

    function invoiceNsIdentityChanged() {
      return !sameNsIdentityAfterUpdate();
    }

    function invoiceNeedsEmpenhoRevalidation() {
      return !invoiceHasControlledNs(resource.data)
        || invoiceNsIdentityChanged()
        || invoiceIdentityChanged();
    }

    function preservesLegacyNsIdentity() {
      return invoiceHasLegacyNsIdentity(resource.data)
        && invoiceHasLegacyNsIdentity(request.resource.data)
        && request.resource.data.numeroNS == resource.data.numeroNS;
    }

    function validInvoiceCreate(workspaceId, id) {
      return invoiceNsFieldIsValid(request.resource.data)
        && request.resource.data.empenhoId is string
        && !empenhoDeletionIsLockedAfter(workspaceId, request.resource.data.empenhoId)
        && (
          !invoiceHasControlledNs(request.resource.data)
          || (
            invoiceHasCanonicalNsIdentity(request.resource.data)
            && canonicalInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
            && invoiceEmpenhoMatchesAfter(workspaceId, request.resource.data)
          )
        );
    }

    function validInvoiceUpdate(workspaceId, id) {
      return invoiceNsFieldIsValid(request.resource.data)
        && oldInvoiceLockReleasedAfter(workspaceId, id)
        && (
          !invoiceHasControlledNs(request.resource.data)
          || (
            (
              (
                invoiceHasCanonicalNsIdentity(request.resource.data)
                && canonicalInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
              )
              || (
                preservesLegacyNsIdentity()
                && legacyInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
              )
            )
            && (
              !invoiceNeedsEmpenhoRevalidation()
              || invoiceEmpenhoMatchesAfter(workspaceId, request.resource.data)
            )
          )
        );
    }

    function validInvoiceDelete(workspaceId, id) {
      return deletedInvoiceLockReleasedAfter(workspaceId, id);
    }

    function sagNsLockTargetMatchesAfter(workspaceId) {
      let invoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return existsAfter(invoicePath)
        && getAfter(invoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(invoicePath).data.id == request.resource.data.invoiceId
        && getAfter(invoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(invoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(invoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && 'nsUg' in getAfter(invoicePath).data
            && getAfter(invoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(invoicePath).data)
          )
        );
    }

    function validSagNsLock(workspaceId, id) {
      return isSagNsLockId(id)
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'ug',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'ug',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == id
        && request.resource.data.id == sagNsLockIdForIdentity(
          request.resource.data.ug,
          request.resource.data.numeroNS
        )
        && request.resource.data.type == 'sag-ns-lock'
        && request.resource.data.workspaceId == workspaceId
        && isValidNsUg(request.resource.data.ug)
        && workspaceUgMatchesNs(workspaceId, request.resource.data.ug)
        && isValidNsNumber(request.resource.data.numeroNS)
        && request.resource.data.invoiceRecordKey is string
        && request.resource.data.invoiceRecordKey.size() > 0
        && request.resource.data.invoiceId is string
        && request.resource.data.invoiceId.size() > 0
        && request.resource.data.empenhoId is string
        && request.resource.data.empenhoId.size() > 0
        && isValidCnpjShape(request.resource.data.supplierCnpj)
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid
        && sagNsLockTargetMatchesAfter(workspaceId);
    }

    function validLegacySagNsLockUpdate(workspaceId, id) {
      return isSagNsLockId(id)
        && !('ug' in resource.data)
        && !('ug' in request.resource.data)
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == id
        && request.resource.data.id == legacySagNsLockIdForNumber(request.resource.data.numeroNS)
        && request.resource.data.type == 'sag-ns-lock'
        && request.resource.data.workspaceId == workspaceId
        && isValidNsNumber(request.resource.data.numeroNS)
        && request.resource.data.updatedBy == request.auth.uid
        && sagNsLockTargetMatchesAfter(workspaceId);
    }

    function sagNsLockOwnerUnchanged() {
      return resource.data.invoiceRecordKey == request.resource.data.invoiceRecordKey
        && resource.data.invoiceId == request.resource.data.invoiceId
        && resource.data.empenhoId == request.resource.data.empenhoId
        && resource.data.supplierCnpj == request.resource.data.supplierCnpj;
    }

    function validSagNsLockOwnerMigration(workspaceId) {
      let oldInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(resource.data.invoiceRecordKey);
      let newInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return resource.data.invoiceRecordKey != request.resource.data.invoiceRecordKey
        && !existsAfter(oldInvoicePath)
        && existsAfter(newInvoicePath)
        && getAfter(newInvoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(newInvoicePath).data.id == request.resource.data.invoiceId
        && getAfter(newInvoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(newInvoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(newInvoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && getAfter(newInvoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(newInvoicePath).data)
          )
        );
    }

    function validSagNsLockMetadataRefresh(workspaceId) {
      let ownerInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return resource.data.invoiceRecordKey == request.resource.data.invoiceRecordKey
        && existsAfter(ownerInvoicePath)
        && getAfter(ownerInvoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(ownerInvoicePath).data.id == request.resource.data.invoiceId
        && getAfter(ownerInvoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(ownerInvoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(ownerInvoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && getAfter(ownerInvoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(ownerInvoicePath).data)
          )
        );
    }

    function validSagNsLockDelete(workspaceId, id) {
      let ownerInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(resource.data.invoiceRecordKey);
      return isSagNsLockId(id)
        && resource.data.type == 'sag-ns-lock'
        && resource.data.workspaceId == workspaceId
        && (
          !existsAfter(ownerInvoicePath)
          || (
            existsAfter(ownerInvoicePath)
            && (
              !('numeroNS' in getAfter(ownerInvoicePath).data)
              || getAfter(ownerInvoicePath).data.numeroNS != resource.data.numeroNS
              || (
                'ug' in resource.data
                && (
                  !('nsUg' in getAfter(ownerInvoicePath).data)
                  || getAfter(ownerInvoicePath).data.nsUg != resource.data.ug
                )
              )
              || (
                !('ug' in resource.data)
                && 'nsUg' in getAfter(ownerInvoicePath).data
              )
            )
          )
        );
    }

    function validSagNsLockUpdate(workspaceId, id) {
      return (
          (
            'ug' in resource.data
            && validSagNsLock(workspaceId, id)
            && resource.data.ug == request.resource.data.ug
          )
          || (
            !('ug' in resource.data)
            && validLegacySagNsLockUpdate(workspaceId, id)
          )
        )
        && resource.data.id == request.resource.data.id
        && resource.data.type == request.resource.data.type
        && resource.data.workspaceId == request.resource.data.workspaceId
        && resource.data.numeroNS == request.resource.data.numeroNS
        && resource.data.createdAt == request.resource.data.createdAt
        && (
          sagNsLockOwnerUnchanged()
          || validSagNsLockMetadataRefresh(workspaceId)
          || validSagNsLockOwnerMigration(workspaceId)
        );
    }

    function isSelfPlatformAccount() {
      return isVerifiedUser()
        && resource.data.accountType == 'sector'
        && identityMatchesAccount(resource.data);
    }

    function selfAccountImmutableFieldsPreserved(accountId) {
      return request.resource.data.email == resource.data.email
        && request.resource.data.email == accountId
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.workspaceId == resource.data.workspaceId
        && (
          (
            !('ug' in resource.data)
            && !('ug' in request.resource.data)
          )
          || (
            'ug' in resource.data
            && 'ug' in request.resource.data
            && request.resource.data.ug == resource.data.ug
          )
        )
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function selfAccountWorkspaceIsActive(accountId) {
      return resource.data.workspaceId is string
        && exists(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        )
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.id == resource.data.workspaceId
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.authorizedEmail == accountId
        && (
          (
            !('ug' in resource.data)
            && !('ug' in get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data)
          )
          || (
            'ug' in resource.data
            && 'ug' in get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data
            && resource.data.ug == get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data.ug
          )
        );
    }

    function isSelfUidBinding(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && !hasBoundUid(resource.data)
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firstLoginAt is string
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firebaseUid',
          'firstLoginAt',
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isSelfPreboundFirstLogin(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && hasBoundUid(resource.data)
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && !('firstLoginAt' in resource.data)
        && request.resource.data.firstLoginAt is string
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstLoginAt',
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isSelfBoundSessionRefresh(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && hasBoundUid(resource.data)
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.firstLoginAt == resource.data.firstLoginAt
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isValidAuditOperation(operation) {
      return operation in [
        'ns.assign',
        'ns.replace',
        'ns.remove',
        'invoice.identity_migrate',
        'invoice.delete',
        'invoice.bulk_delete',
        'empenho.delete',
        'supplier_cnpj.migrate',
        'sector.create',
        'sector.profile_update',
        'sector.status_change',
        'sector.ug_backfill',
        'sector.password_reset',
        'sector.delete',
        'session.terminate',
        'billing.config_update',
        'billing.trial_grant',
        'billing.status_change',
        'billing.payment_confirm',
        'billing.payment_reopen',
        'historical.repair'
      ];
    }

    function isValidAuditSource(source) {
      return source in ['sag', 'manual', 'migration', 'system', 'admin'];
    }

    function isValidAuditEntityType(entityType) {
      return entityType in [
        'invoice',
        'invoice_batch',
        'empenho',
        'workspace',
        'session',
        'billing_config',
        'billing_account',
        'billing_cycle',
        'ns_lock'
      ];
    }

    function auditUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return (
          workspaceId == 'hgesm-aprov'
          && ug == '160416'
          && (
            !('ug' in workspace)
            || workspace.ug == '160416'
          )
        )
        || (
          ug == null
          && !('ug' in workspace)
        )
        || (
          ug is string
          && 'ug' in workspace
          && workspace.ug == ug
          && isValidUnitUg(ug)
        );
    }

    function validAuditEventShape(eventId, workspaceId) {
      return request.resource.data.keys().hasAll([
          'eventVersion',
          'eventId',
          'workspaceId',
          'ug',
          'operation',
          'source',
          'entityType',
          'entityId',
          'correlationId',
          'actorUid',
          'actorEmail',
          'before',
          'after',
          'metadata',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'eventVersion',
          'eventId',
          'workspaceId',
          'ug',
          'operation',
          'source',
          'entityType',
          'entityId',
          'correlationId',
          'actorUid',
          'actorEmail',
          'before',
          'after',
          'metadata',
          'createdAt'
        ])
        && request.resource.data.eventVersion == 'emprovex_audit_v1'
        && request.resource.data.eventId == eventId
        && request.resource.data.workspaceId == workspaceId
        && isValidAuditOperation(request.resource.data.operation)
        && isValidAuditSource(request.resource.data.source)
        && isValidAuditEntityType(request.resource.data.entityType)
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() > 0
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.before is map
        && request.resource.data.after is map
        && request.resource.data.metadata is map
        && request.resource.data.createdAt == request.time;
    }

    function validWorkspaceAuditEvent(eventId, workspaceId) {
      return validAuditEventShape(eventId, workspaceId)
        && auditUgMatchesWorkspace(workspaceId, request.resource.data.ug);
    }

    function validPlatformAuditEvent(eventId) {
      return isPlatformAdmin()
        && validAuditEventShape(
          eventId,
          request.resource.data.workspaceId
        )
        && request.resource.data.source == 'admin'
        && request.resource.data.operation in [
          'sector.create',
          'sector.profile_update',
          'sector.status_change',
          'sector.ug_backfill',
          'sector.password_reset',
          'sector.delete',
          'session.terminate',
          'billing.config_update',
          'billing.trial_grant',
          'billing.status_change',
          'billing.payment_confirm',
          'billing.payment_reopen'
        ];
    }

    function backupUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return isValidUnitUg(ug)
        && (
          (
            workspaceId == 'hgesm-aprov'
            && ug == '160416'
            && (
              !('ug' in workspace)
              || workspace.ug == '160416'
            )
          )
          || (
            'ug' in workspace
            && isValidUnitUg(workspace.ug)
            && workspace.ug == ug
          )
        );
    }

    function validWorkspaceBackupStatus(workspaceId) {
      return canAccessWorkspace(workspaceId)
        && request.resource.data.keys().hasAll([
          'workspaceId',
          'ug',
          'accountEmail',
          'status',
          'lastAttemptAt',
          'lastSuccessAt',
          'latestFileId',
          'latestFileName',
          'sizeBytes',
          'recordCount',
          'schemaVersion',
          'sha256',
          'trigger',
          'lastError',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'workspaceId',
          'ug',
          'accountEmail',
          'status',
          'lastAttemptAt',
          'lastSuccessAt',
          'latestFileId',
          'latestFileName',
          'sizeBytes',
          'recordCount',
          'schemaVersion',
          'sha256',
          'trigger',
          'lastError',
          'updatedBy'
        ])
        && request.resource.data.workspaceId == workspaceId
        && backupUgMatchesWorkspace(workspaceId, request.resource.data.ug)
        && request.resource.data.accountEmail == request.auth.token.email
        && request.resource.data.status in ['success', 'failed', 'in_progress']
        && request.resource.data.lastAttemptAt is string
        && request.resource.data.lastSuccessAt is string
        && request.resource.data.latestFileId is string
        && request.resource.data.latestFileName is string
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes >= 0
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount >= 0
        && request.resource.data.schemaVersion == 1
        && request.resource.data.sha256 is string
        && request.resource.data.trigger in ['automatic', 'manual']
        && request.resource.data.lastError is string
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Diretório administrativo da plataforma. O administrador pode listar e
    // manter metadados, mas não recebe acesso operacional aos workspaces externos.
    match /workspaces/{workspaceId} {
      allow get: if isPlatformAdmin()
        || canReadWorkspaceMetadataFromResource(workspaceId);
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validWorkspaceCreate(workspaceId)
        && workspaceHasMatchingAccountAfterWrite(workspaceId);
      allow update: if isPlatformAdmin()
        && workspaceId != 'hgesm-aprov'
        && validWorkspaceAdminUpdate(workspaceId)
        && workspaceHasMatchingAccountAfterWrite(workspaceId);
      allow delete: if false;
    }

    match /platformAccounts/{accountId} {
      allow get: if isPlatformAdmin() || isSelfPlatformAccount();
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validSectorAccountCreate(accountId)
        && accountHasMatchingWorkspaceAfterWrite(accountId);
      allow update: if (
          isPlatformAdmin()
          && accountId != 'aprov1hgesm@gmail.com'
          && validSectorAccountAdminUpdate(accountId)
          && accountHasMatchingWorkspaceAfterWrite(accountId)
        )
        || isSelfUidBinding(accountId)
        || isSelfPreboundFirstLogin(accountId)
        || isSelfBoundSessionRefresh(accountId);
      allow delete: if false;
    }

    match /platformAuditEvents/{eventId} {
      allow get, list: if isPlatformAdmin();
      allow create: if validPlatformAuditEvent(eventId);
      allow update, delete: if false;
    }

    match /platformUgIndex/{ug} {
      allow get, list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly([
          'ug',
          'workspaceId',
          'email',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.ug == ug
        && isValidUnitUg(ug)
        && request.resource.data.workspaceId is string
        && request.resource.data.email is string
        && existsAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        )
        && existsAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        )
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.ug == ug
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.authorizedEmail == request.resource.data.email
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        ).data.ug == ug
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        ).data.workspaceId == request.resource.data.workspaceId;
      allow update, delete: if false;
    }

    // Commercial readiness — metadados de backup. O fundador enxerga apenas
    // saúde/telemetria; o conteúdo operacional continua tenant-scoped.
    match /workspaceBackupStatus/{workspaceId} {
      allow get: if isPlatformAdmin() || canAccessWorkspace(workspaceId);
      allow list: if isPlatformAdmin();
      allow create, update: if validWorkspaceBackupStatus(workspaceId);
      allow delete: if false;
    }

    // Metadados do backup global de identidade. Nunca contém hashes/senhas.
    match /platformRecoveryStatus/{id} {
      allow get, list, create, update: if isPlatformAdmin();
      allow delete: if false;
    }

    // Block 16.2 — collection-group read used only by the founder dashboard.
    // This recursive match grants no writes and no access to external sectors.
    match /{path=**}/sessionSlots/{slotId} {
      allow get, list: if isPlatformAdmin();
    }

    // Block 16.2 — collection-group queries require a recursive match. This
    // grants only global LIST to the platform admin; no create/update/delete
    // permission is introduced here and sector users receive no access.
    match /{sessionSlotPath=**}/sessionSlots/{slotId} {
      allow list: if isPlatformAdmin();
    }

    // Block 16.1 — capacity metadata. These two fixed slots enforce a maximum of
    // two simultaneous external-sector browser sessions without query/count races.
    // The founder is exempt and never claims a slot.
    match /workspaces/{workspaceId}/sessionSlots/{slotId} {
      allow get, list: if canAccessWorkspace(workspaceId) || isPlatformAdmin();
      allow create: if validWorkspaceSessionLeaseCreate(workspaceId, slotId);
      allow update: if validWorkspaceSessionLeaseUpdate(workspaceId, slotId);
      allow delete: if validWorkspaceSessionLeaseDelete(workspaceId, slotId)
        || validAdminSessionSlotDelete(workspaceId, slotId);
    }

    // Block 16.2 — tombstones curtos impedem uma sessão encerrada remotamente
    // de recriar o slot com o mesmo sessionId.
    match /workspaces/{workspaceId}/sessionRevocations/{sessionId} {
      // O cliente precisa poder consultar um sessionId que normalmente ainda não
      // existe. Por isso o GET é tenant-scoped pelo workspace, sem depender de
      // resource.data; LIST continua exclusivo da administração.
      allow get: if isPlatformAdmin() || canAccessWorkspace(workspaceId);
      allow list: if isPlatformAdmin();
      allow create: if validSessionRevocationCreate(workspaceId, sessionId);
      allow update, delete: if false;
    }

    // Histórico global de cota/faturamento: escrito exclusivamente pelo servidor
    // via IAM e somente legível pela conta fundadora. Clientes jamais podem forjar
    // a série histórica usada nos relatórios administrativos.
    match /platformUsageHistory/{dayKey} {
      allow get, list: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // Block 16.3 — low-frequency workspace usage estimates. Sector clients can
    // only append monotonically to their own UG counters; only the founder can read.
    match /workspaces/{workspaceId}/usageEstimates/{dayKey} {
      allow get, list: if isPlatformAdmin();
      allow create: if validWorkspaceUsageEstimateCreate(workspaceId, dayKey);
      allow update: if validWorkspaceUsageEstimateUpdate(workspaceId, dayKey);
      allow delete: if false;
    }

    function validHomeSnapshotNumber(value) {
      return value is number && value >= 0;
    }

    function homeSnapshotUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return isValidUnitUg(ug)
        && (
          (
            workspaceId == 'hgesm-aprov'
            && ug == '160416'
            && (
              !('ug' in workspace)
              || workspace.ug == '160416'
            )
          )
          || (
            'ug' in workspace
            && isValidUnitUg(workspace.ug)
            && workspace.ug == ug
          )
        );
    }

    function validHomeSnapshot(workspaceId) {
      return canAccessWorkspace(workspaceId)
        && request.resource.data.keys().hasAll([
          'snapshotVersion',
          'workspaceId',
          'ug',
          'contentHash',
          'generatedAt',
          'generatedBy',
          'metrics',
          'alerts',
          'receiving',
          'execution',
          'classStats',
          'stars'
        ])
        && request.resource.data.keys().hasOnly([
          'snapshotVersion',
          'workspaceId',
          'ug',
          'contentHash',
          'generatedAt',
          'generatedBy',
          'metrics',
          'alerts',
          'receiving',
          'execution',
          'classStats',
          'stars'
        ])
        && request.resource.data.snapshotVersion == 'emprovex_home_snapshot_v1'
        && request.resource.data.workspaceId == workspaceId
        && homeSnapshotUgMatchesWorkspace(workspaceId, request.resource.data.ug)
        && request.resource.data.contentHash is string
        && request.resource.data.contentHash.matches('^[0-9a-f]{8}$')
        && request.resource.data.generatedAt is string
        && request.resource.data.generatedAt.size() > 10
        && request.resource.data.generatedBy == request.auth.uid
        && request.resource.data.metrics is map
        && request.resource.data.metrics.keys().hasOnly([
          'totalEmpenhos',
          'totalValue'
        ])
        && validHomeSnapshotNumber(request.resource.data.metrics.totalEmpenhos)
        && validHomeSnapshotNumber(request.resource.data.metrics.totalValue)
        && request.resource.data.alerts is map
        && request.resource.data.alerts.keys().hasOnly([
          'total',
          'critical',
          'attention'
        ])
        && validHomeSnapshotNumber(request.resource.data.alerts.total)
        && validHomeSnapshotNumber(request.resource.data.alerts.critical)
        && validHomeSnapshotNumber(request.resource.data.alerts.attention)
        && request.resource.data.receiving is map
        && request.resource.data.receiving.keys().hasOnly([
          'pendingEmpenhos',
          'pendingItems',
          'balance'
        ])
        && validHomeSnapshotNumber(request.resource.data.receiving.pendingEmpenhos)
        && validHomeSnapshotNumber(request.resource.data.receiving.pendingItems)
        && validHomeSnapshotNumber(request.resource.data.receiving.balance)
        && request.resource.data.execution is map
        && request.resource.data.execution.keys().hasOnly([
          'committed',
          'received',
          'percentage'
        ])
        && validHomeSnapshotNumber(request.resource.data.execution.committed)
        && validHomeSnapshotNumber(request.resource.data.execution.received)
        && validHomeSnapshotNumber(request.resource.data.execution.percentage)
        && request.resource.data.execution.percentage <= 100
        && request.resource.data.classStats is list
        && request.resource.data.classStats.size() <= 32
        && request.resource.data.stars is list
        && request.resource.data.stars.size() <= 72;
    }

    // Workspace-scoped operational data. There is deliberately no admin bypass:
    // a platform administrator cannot read another sector's operational records.
    match /workspaces/{workspaceId}/auditEvents/{eventId} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validWorkspaceAuditEvent(eventId, workspaceId);
      allow update, delete: if false;
    }

    match /workspaces/{workspaceId}/empenhos/{id} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validEmpenhoRevisionCreate(request.resource.data)
        && empenhoCnpjCreateIsValid(request.resource.data);
      allow update: if canAccessWorkspace(workspaceId)
        && !empenhoDeletionIsLockedAfter(workspaceId, id)
        && validEmpenhoRevisionUpdate()
        && empenhoCnpjUpdateIsValid();
      allow delete: if canAccessWorkspace(workspaceId)
        && validEmpenhoLifecycleDelete(workspaceId, id);
    }

    match /workspaces/{workspaceId}/alerts/{id} {
      allow read, delete: if canAccessWorkspace(workspaceId);
      allow create, update: if canAccessWorkspace(workspaceId)
        && linkedEmpenhoWriteAllowedAfter(workspaceId, request.resource.data);
    }

    match /workspaces/{workspaceId}/invoices/{id} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validInvoiceCreate(workspaceId, id);
      allow update: if canAccessWorkspace(workspaceId)
        && validInvoiceUpdate(workspaceId, id);
      allow delete: if canAccessWorkspace(workspaceId)
        && validInvoiceDelete(workspaceId, id);
    }

    match /workspaces/{workspaceId}/comissoes/{id} {
      allow read, write: if canAccessWorkspace(workspaceId);
    }

    match /workspaces/{workspaceId}/cronogramas/{id} {
      allow read, delete: if canAccessWorkspace(workspaceId);
      allow create, update: if canAccessWorkspace(workspaceId)
        && linkedEmpenhoWriteAllowedAfter(workspaceId, request.resource.data);
    }

    // Block 19.10 — snapshot econômico do Início.
    // Um único documento derivado alimenta a Home; ele não concede autorização
    // e nunca substitui as coleções operacionais como fonte de verdade.
    match /workspaces/{workspaceId}/settings/homeSnapshot {
      allow read: if canAccessWorkspace(workspaceId);
      allow create, update: if validHomeSnapshot(workspaceId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/termoRecebimentoCounter {
      // O cadastro administrativo verifica se existe contador residual antes de
      // provisionar um workspace novo. Essa leitura prévia só é permitida enquanto
      // o workspace ainda não existe; depois da criação, o administrador volta a
      // não possuir acesso ao contador operacional do tenant.
      allow read: if canAccessWorkspace(workspaceId)
        || (
          isPlatformAdmin()
          && !workspaceExists(workspaceId)
        );
      allow create: if canAdminProvisionTermCounter(workspaceId)
        || (
          canAccessWorkspace(workspaceId)
          && validInitialTermCounter()
        );
      allow update: if canAccessWorkspace(workspaceId)
        && validOperationalTermCounterUpdate();
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/documentStorage {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validWorkspaceDocumentStorage(workspaceId);
      allow update: if canAccessWorkspace(workspaceId)
        && validWorkspaceDocumentStorageUpdate(workspaceId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/{id} {
      // Listagem é limitada ao próprio workspace autenticado. Os settings atuais
      // já são individualmente legíveis pelo setor; o list habilita diagnósticos
      // de integridade sem ampliar acesso entre tenants.
      allow list: if canAccessWorkspace(workspaceId);
      allow get: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId);
      allow create: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && (
          (
            isEmpenhoDeletionLockId(id)
            && validEmpenhoDeletionLockCreate(workspaceId, id)
          )
          || (
            !isEmpenhoDeletionLockId(id)
            && (
              !isSagNsLockId(id)
              || validSagNsLock(workspaceId, id)
            )
          )
        );
      allow update: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && !isEmpenhoDeletionLockId(id)
        && (
          !isSagNsLockId(id)
          || validSagNsLockUpdate(workspaceId, id)
        );
      allow delete: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && (
          (
            isEmpenhoDeletionLockId(id)
            && validEmpenhoDeletionLockDelete(workspaceId, id)
          )
          || (
            !isEmpenhoDeletionLockId(id)
            && (
              !isSagNsLockId(id)
              || validSagNsLockDelete(workspaceId, id)
            )
          )
        );
    }

    // Bloco 13 — compatibilidade legada somente leitura.
    // O runtime oficial já usa /workspaces/hgesm-aprov/...; os dados raiz ficam
    // preservados apenas para consulta, auditoria e recuperação controlada.
    // Qualquer rollback com escrita exige mudança explícita de Rules, evitando que
    // uma simples regressão de frontend volte silenciosamente a gravar no legado.
    match /empenhos/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /alerts/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /invoices/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /comissoes/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /cronogramas/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    // A identidade visual global precisa continuar disponível antes do login.
    // A marca institucional é imutável no runtime: qualquer troca futura exige
    // manutenção deliberada fora da aplicação e revisão explícita destas Rules.
    match /settings/global {
      allow read: if true;
      allow write: if false;
    }

    // Demais settings raiz (incluindo o contador histórico) ficam somente leitura.
    match /settings/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }
  }
}
)
        && request.resource.data.status in ['open', 'pending', 'paid', 'waived']
        && request.resource.data.confirmedAt is string
        && request.resource.data.confirmedBy is string
        && request.resource.data.note is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string;
    }

    function validBillingCycleUpdate(cycleId) {
      return validBillingCycle(cycleId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.ug == resource.data.ug
        && request.resource.data.referenceMonth == resource.data.referenceMonth
        && request.resource.data.amountCents == resource.data.amountCents
        && request.resource.data.dueDate == resource.data.dueDate
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validInitialTermCounter() {
      return request.resource.data.keys().hasOnly(['currentNumber'])
        && request.resource.data.currentNumber is int
        && request.resource.data.currentNumber == 0;
    }

    function canAdminProvisionTermCounter(workspaceId) {
      let workspace = getAfter(
        /databases/$(database)/documents/workspaces/$(workspaceId)
      ).data;
      let account = getAfter(
        /databases/$(database)/documents/platformAccounts/$(workspace.authorizedEmail)
      ).data;

      return isPlatformAdmin()
        && workspace.id == workspaceId
        && workspace.status == 'active'
        && workspace.authorizedEmail is string
        && account.accountType == 'sector'
        && account.status == 'active'
        && account.workspaceId == workspaceId
        && account.email == workspace.authorizedEmail
        && 'ug' in workspace
        && 'ug' in account
        && isValidUnitUg(workspace.ug)
        && workspace.ug == account.ug
        && validInitialTermCounter();
    }

    function validOperationalTermCounterUpdate() {
      return request.resource.data.currentNumber is int
        && request.resource.data.currentNumber >= 0
        && resource.data.currentNumber is int
        && request.resource.data.currentNumber >= resource.data.currentNumber
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentNumber'
        ]);
    }

    function validWorkspaceDocumentStorage(workspaceId) {
      return request.resource.data.keys().hasAll([
          'provider',
          'status',
          'workspaceId',
          'accountEmail',
          'rootFolderId',
          'empenhosFolderId',
          'invoicesFolderId',
          'configuredAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'provider',
          'status',
          'workspaceId',
          'accountEmail',
          'rootFolderId',
          'empenhosFolderId',
          'invoicesFolderId',
          'configuredAt',
          'updatedAt'
        ])
        && request.resource.data.provider == 'google-drive'
        && request.resource.data.status == 'configured'
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.accountEmail == request.auth.token.email
        && request.resource.data.rootFolderId is string
        && request.resource.data.rootFolderId.size() > 5
        && request.resource.data.empenhosFolderId is string
        && request.resource.data.empenhosFolderId.size() > 5
        && request.resource.data.invoicesFolderId is string
        && request.resource.data.invoicesFolderId.size() > 5
        && request.resource.data.configuredAt is string
        && request.resource.data.updatedAt is string;
    }

    function validWorkspaceDocumentStorageUpdate(workspaceId) {
      return validWorkspaceDocumentStorage(workspaceId)
        && resource.data.provider == 'google-drive'
        && resource.data.workspaceId == workspaceId
        && resource.data.accountEmail == request.auth.token.email
        && request.resource.data.configuredAt == resource.data.configuredAt;
    }

    function isSagNsLockId(id) {
      return id.matches('^sagNsLock_.+');
    }

    function isValidNsNumber(value) {
      return value is string
        && value.matches('^[0-9]{4}NS[0-9]{6}$');
    }

    function isValidNsUg(value) {
      return isValidUnitUg(value);
    }

    function isValidCnpjShape(value) {
      return value is string
        && value.matches('^[0-9A-Z]{12}[0-9]{2}$');
    }

    function empenhoCnpjCreateIsValid(data) {
      return !('supplierCnpj' in data)
        || isValidCnpjShape(data.supplierCnpj);
    }

    function empenhoCnpjUpdateIsValid() {
      return !('supplierCnpj' in request.resource.data)
        || isValidCnpjShape(request.resource.data.supplierCnpj)
        || (
          'supplierCnpj' in resource.data
          && request.resource.data.supplierCnpj == resource.data.supplierCnpj
        );
    }

    function validEmpenhoRevisionCreate(data) {
      return data.keys().hasAll([
          'revision',
          'updatedAt',
          'updatedBy'
        ])
        && data.revision is int
        && data.revision == 1
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedBy == request.auth.uid;
    }

    function validEmpenhoRevisionUpdate() {
      let currentRevision = 'revision' in resource.data
        ? resource.data.revision
        : 0;
      return currentRevision is int
        && currentRevision >= 0
        && request.resource.data.revision is int
        && request.resource.data.revision == currentRevision + 1
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() > 0
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function empenhoDeletionLockId(empenhoId) {
      return 'empenhoDelete_' + empenhoId;
    }

    function isEmpenhoDeletionLockId(id) {
      return id.matches('^empenhoDelete_.+$');
    }

    function empenhoDeletionIsLockedAfter(workspaceId, empenhoId) {
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(empenhoDeletionLockId(empenhoId));
      return empenhoId is string
        && existsAfter(lockPath);
    }

    function linkedEmpenhoWriteAllowedAfter(workspaceId, data) {
      return !('empenhoId' in data)
        || (
          data.empenhoId is string
          && !empenhoDeletionIsLockedAfter(workspaceId, data.empenhoId)
        );
    }

    function validEmpenhoDeletionLockCreate(workspaceId, id) {
      let empenhoId = request.resource.data.empenhoId;
      let empenhoPath = /databases/$(database)/documents/workspaces/$(workspaceId)/empenhos/$(empenhoId);
      return isEmpenhoDeletionLockId(id)
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'empenhoId',
          'correlationId',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'empenhoId',
          'correlationId',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.id == id
        && id == empenhoDeletionLockId(empenhoId)
        && request.resource.data.type == 'empenho-deletion-lock'
        && request.resource.data.workspaceId == workspaceId
        && empenhoId is string
        && empenhoId.size() > 0
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy == request.auth.uid
        && existsAfter(empenhoPath)
        && getAfter(empenhoPath).data.id == empenhoId;
    }

    function validEmpenhoDeletionLockDelete(workspaceId, id) {
      return isEmpenhoDeletionLockId(id)
        && resource.data.id == id
        && resource.data.type == 'empenho-deletion-lock'
        && resource.data.workspaceId == workspaceId
        && resource.data.createdBy == request.auth.uid;
    }

    function validEmpenhoLifecycleDelete(workspaceId, empenhoId) {
      let lockId = empenhoDeletionLockId(empenhoId);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return exists(lockPath)
        && get(lockPath).data.id == lockId
        && get(lockPath).data.type == 'empenho-deletion-lock'
        && get(lockPath).data.workspaceId == workspaceId
        && get(lockPath).data.empenhoId == empenhoId
        && get(lockPath).data.createdBy == request.auth.uid
        && !existsAfter(lockPath);
    }

    function invoiceHasControlledNs(data) {
      return 'numeroNS' in data
        && isValidNsNumber(data.numeroNS);
    }

    function invoiceHasCanonicalNsIdentity(data) {
      return invoiceHasControlledNs(data)
        && 'nsUg' in data
        && isValidNsUg(data.nsUg);
    }

    function invoiceHasLegacyNsIdentity(data) {
      return invoiceHasControlledNs(data)
        && !('nsUg' in data);
    }

    function invoiceNsFieldIsValid(data) {
      return (
          !('numeroNS' in data)
          && !('nsUg' in data)
        )
        || (
          isValidNsNumber(data.numeroNS)
          && (
            !('nsUg' in data)
            || isValidNsUg(data.nsUg)
          )
        );
    }

    function sagNsLockIdForIdentity(ug, numeroNS) {
      return 'sagNsLock_' + ug + '_' + numeroNS;
    }

    function legacySagNsLockIdForNumber(numeroNS) {
      return 'sagNsLock_' + numeroNS;
    }

    function invoiceEmpenhoMatchesAfter(workspaceId, data) {
      let empenhoPath = /databases/$(database)/documents/workspaces/$(workspaceId)/empenhos/$(data.empenhoId);
      return data.empenhoId is string
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(empenhoPath)
        && getAfter(empenhoPath).data.id == data.empenhoId
        && getAfter(empenhoPath).data.supplierCnpj == data.supplierCnpj;
    }

    function workspaceUgMatchesNs(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return (
          workspaceId == 'hgesm-aprov'
          && ug == '160416'
          && (
            !('ug' in workspace)
            || workspace.ug == '160416'
          )
        )
        || (
          'ug' in workspace
          && isValidUnitUg(workspace.ug)
          && workspace.ug == ug
        );
    }

    function canonicalInvoiceLockMatchesAfter(workspaceId, id, data) {
      let lockId = sagNsLockIdForIdentity(data.nsUg, data.numeroNS);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return invoiceHasCanonicalNsIdentity(data)
        && data.recordKey == id
        && data.id is string
        && data.id.size() > 0
        && data.empenhoId is string
        && data.empenhoId.size() > 0
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(lockPath)
        && getAfter(lockPath).data.id == lockId
        && getAfter(lockPath).data.type == 'sag-ns-lock'
        && getAfter(lockPath).data.workspaceId == workspaceId
        && getAfter(lockPath).data.ug == data.nsUg
        && getAfter(lockPath).data.numeroNS == data.numeroNS
        && getAfter(lockPath).data.invoiceRecordKey == id
        && getAfter(lockPath).data.invoiceId == data.id
        && getAfter(lockPath).data.empenhoId == data.empenhoId
        && getAfter(lockPath).data.supplierCnpj == data.supplierCnpj;
    }

    function legacyInvoiceLockMatchesAfter(workspaceId, id, data) {
      let lockId = legacySagNsLockIdForNumber(data.numeroNS);
      let lockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(lockId);
      return invoiceHasLegacyNsIdentity(data)
        && data.recordKey == id
        && data.id is string
        && data.id.size() > 0
        && data.empenhoId is string
        && data.empenhoId.size() > 0
        && isValidCnpjShape(data.supplierCnpj)
        && existsAfter(lockPath)
        && getAfter(lockPath).data.id == lockId
        && getAfter(lockPath).data.type == 'sag-ns-lock'
        && getAfter(lockPath).data.workspaceId == workspaceId
        && !('ug' in getAfter(lockPath).data)
        && getAfter(lockPath).data.numeroNS == data.numeroNS
        && getAfter(lockPath).data.invoiceRecordKey == id
        && getAfter(lockPath).data.invoiceId == data.id
        && getAfter(lockPath).data.empenhoId == data.empenhoId
        && getAfter(lockPath).data.supplierCnpj == data.supplierCnpj;
    }

    function invoiceLockMatchesAfter(workspaceId, id, data) {
      return canonicalInvoiceLockMatchesAfter(workspaceId, id, data)
        || legacyInvoiceLockMatchesAfter(workspaceId, id, data);
    }

    function sameNsIdentityAfterUpdate() {
      return invoiceHasControlledNs(request.resource.data)
        && request.resource.data.numeroNS == resource.data.numeroNS
        && (
          (
            !('nsUg' in resource.data)
            && !('nsUg' in request.resource.data)
          )
          || (
            'nsUg' in resource.data
            && 'nsUg' in request.resource.data
            && request.resource.data.nsUg == resource.data.nsUg
          )
        );
    }

    function controlledOldInvoiceLockReleasedAfter(workspaceId, id) {
      let oldLockId = invoiceHasCanonicalNsIdentity(resource.data)
        ? sagNsLockIdForIdentity(resource.data.nsUg, resource.data.numeroNS)
        : legacySagNsLockIdForNumber(resource.data.numeroNS);
      let oldLockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(oldLockId);
      return sameNsIdentityAfterUpdate()
        || !existsAfter(oldLockPath)
        || getAfter(oldLockPath).data.invoiceRecordKey != id;
    }

    function oldInvoiceLockReleasedAfter(workspaceId, id) {
      return !invoiceHasControlledNs(resource.data)
        || controlledOldInvoiceLockReleasedAfter(workspaceId, id);
    }

    function controlledDeletedInvoiceLockReleasedAfter(workspaceId, id) {
      let oldLockId = invoiceHasCanonicalNsIdentity(resource.data)
        ? sagNsLockIdForIdentity(resource.data.nsUg, resource.data.numeroNS)
        : legacySagNsLockIdForNumber(resource.data.numeroNS);
      let oldLockPath = /databases/$(database)/documents/workspaces/$(workspaceId)/settings/$(oldLockId);
      return !existsAfter(oldLockPath)
        || getAfter(oldLockPath).data.invoiceRecordKey != id;
    }

    function deletedInvoiceLockReleasedAfter(workspaceId, id) {
      return !invoiceHasControlledNs(resource.data)
        || controlledDeletedInvoiceLockReleasedAfter(workspaceId, id);
    }

    function invoiceIdentityChanged() {
      return !('recordKey' in resource.data)
        || !('supplierCnpj' in resource.data)
        || request.resource.data.recordKey != resource.data.recordKey
        || request.resource.data.id != resource.data.id
        || request.resource.data.empenhoId != resource.data.empenhoId
        || request.resource.data.supplierCnpj != resource.data.supplierCnpj;
    }

    function invoiceNsIdentityChanged() {
      return !sameNsIdentityAfterUpdate();
    }

    function invoiceNeedsEmpenhoRevalidation() {
      return !invoiceHasControlledNs(resource.data)
        || invoiceNsIdentityChanged()
        || invoiceIdentityChanged();
    }

    function preservesLegacyNsIdentity() {
      return invoiceHasLegacyNsIdentity(resource.data)
        && invoiceHasLegacyNsIdentity(request.resource.data)
        && request.resource.data.numeroNS == resource.data.numeroNS;
    }

    function validInvoiceCreate(workspaceId, id) {
      return invoiceNsFieldIsValid(request.resource.data)
        && request.resource.data.empenhoId is string
        && !empenhoDeletionIsLockedAfter(workspaceId, request.resource.data.empenhoId)
        && (
          !invoiceHasControlledNs(request.resource.data)
          || (
            invoiceHasCanonicalNsIdentity(request.resource.data)
            && canonicalInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
            && invoiceEmpenhoMatchesAfter(workspaceId, request.resource.data)
          )
        );
    }

    function validInvoiceUpdate(workspaceId, id) {
      return invoiceNsFieldIsValid(request.resource.data)
        && oldInvoiceLockReleasedAfter(workspaceId, id)
        && (
          !invoiceHasControlledNs(request.resource.data)
          || (
            (
              (
                invoiceHasCanonicalNsIdentity(request.resource.data)
                && canonicalInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
              )
              || (
                preservesLegacyNsIdentity()
                && legacyInvoiceLockMatchesAfter(workspaceId, id, request.resource.data)
              )
            )
            && (
              !invoiceNeedsEmpenhoRevalidation()
              || invoiceEmpenhoMatchesAfter(workspaceId, request.resource.data)
            )
          )
        );
    }

    function validInvoiceDelete(workspaceId, id) {
      return deletedInvoiceLockReleasedAfter(workspaceId, id);
    }

    function sagNsLockTargetMatchesAfter(workspaceId) {
      let invoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return existsAfter(invoicePath)
        && getAfter(invoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(invoicePath).data.id == request.resource.data.invoiceId
        && getAfter(invoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(invoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(invoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && 'nsUg' in getAfter(invoicePath).data
            && getAfter(invoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(invoicePath).data)
          )
        );
    }

    function validSagNsLock(workspaceId, id) {
      return isSagNsLockId(id)
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'ug',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'ug',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == id
        && request.resource.data.id == sagNsLockIdForIdentity(
          request.resource.data.ug,
          request.resource.data.numeroNS
        )
        && request.resource.data.type == 'sag-ns-lock'
        && request.resource.data.workspaceId == workspaceId
        && isValidNsUg(request.resource.data.ug)
        && workspaceUgMatchesNs(workspaceId, request.resource.data.ug)
        && isValidNsNumber(request.resource.data.numeroNS)
        && request.resource.data.invoiceRecordKey is string
        && request.resource.data.invoiceRecordKey.size() > 0
        && request.resource.data.invoiceId is string
        && request.resource.data.invoiceId.size() > 0
        && request.resource.data.empenhoId is string
        && request.resource.data.empenhoId.size() > 0
        && isValidCnpjShape(request.resource.data.supplierCnpj)
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid
        && sagNsLockTargetMatchesAfter(workspaceId);
    }

    function validLegacySagNsLockUpdate(workspaceId, id) {
      return isSagNsLockId(id)
        && !('ug' in resource.data)
        && !('ug' in request.resource.data)
        && request.resource.data.keys().hasAll([
          'id',
          'type',
          'workspaceId',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'workspaceId',
          'numeroNS',
          'invoiceRecordKey',
          'invoiceId',
          'empenhoId',
          'supplierCnpj',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.id == id
        && request.resource.data.id == legacySagNsLockIdForNumber(request.resource.data.numeroNS)
        && request.resource.data.type == 'sag-ns-lock'
        && request.resource.data.workspaceId == workspaceId
        && isValidNsNumber(request.resource.data.numeroNS)
        && request.resource.data.updatedBy == request.auth.uid
        && sagNsLockTargetMatchesAfter(workspaceId);
    }

    function sagNsLockOwnerUnchanged() {
      return resource.data.invoiceRecordKey == request.resource.data.invoiceRecordKey
        && resource.data.invoiceId == request.resource.data.invoiceId
        && resource.data.empenhoId == request.resource.data.empenhoId
        && resource.data.supplierCnpj == request.resource.data.supplierCnpj;
    }

    function validSagNsLockOwnerMigration(workspaceId) {
      let oldInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(resource.data.invoiceRecordKey);
      let newInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return resource.data.invoiceRecordKey != request.resource.data.invoiceRecordKey
        && !existsAfter(oldInvoicePath)
        && existsAfter(newInvoicePath)
        && getAfter(newInvoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(newInvoicePath).data.id == request.resource.data.invoiceId
        && getAfter(newInvoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(newInvoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(newInvoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && getAfter(newInvoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(newInvoicePath).data)
          )
        );
    }

    function validSagNsLockMetadataRefresh(workspaceId) {
      let ownerInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(request.resource.data.invoiceRecordKey);
      return resource.data.invoiceRecordKey == request.resource.data.invoiceRecordKey
        && existsAfter(ownerInvoicePath)
        && getAfter(ownerInvoicePath).data.recordKey == request.resource.data.invoiceRecordKey
        && getAfter(ownerInvoicePath).data.id == request.resource.data.invoiceId
        && getAfter(ownerInvoicePath).data.empenhoId == request.resource.data.empenhoId
        && getAfter(ownerInvoicePath).data.supplierCnpj == request.resource.data.supplierCnpj
        && getAfter(ownerInvoicePath).data.numeroNS == request.resource.data.numeroNS
        && (
          (
            'ug' in request.resource.data
            && getAfter(ownerInvoicePath).data.nsUg == request.resource.data.ug
          )
          || (
            !('ug' in request.resource.data)
            && !('nsUg' in getAfter(ownerInvoicePath).data)
          )
        );
    }

    function validSagNsLockDelete(workspaceId, id) {
      let ownerInvoicePath = /databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(resource.data.invoiceRecordKey);
      return isSagNsLockId(id)
        && resource.data.type == 'sag-ns-lock'
        && resource.data.workspaceId == workspaceId
        && (
          !existsAfter(ownerInvoicePath)
          || (
            existsAfter(ownerInvoicePath)
            && (
              !('numeroNS' in getAfter(ownerInvoicePath).data)
              || getAfter(ownerInvoicePath).data.numeroNS != resource.data.numeroNS
              || (
                'ug' in resource.data
                && (
                  !('nsUg' in getAfter(ownerInvoicePath).data)
                  || getAfter(ownerInvoicePath).data.nsUg != resource.data.ug
                )
              )
              || (
                !('ug' in resource.data)
                && 'nsUg' in getAfter(ownerInvoicePath).data
              )
            )
          )
        );
    }

    function validSagNsLockUpdate(workspaceId, id) {
      return (
          (
            'ug' in resource.data
            && validSagNsLock(workspaceId, id)
            && resource.data.ug == request.resource.data.ug
          )
          || (
            !('ug' in resource.data)
            && validLegacySagNsLockUpdate(workspaceId, id)
          )
        )
        && resource.data.id == request.resource.data.id
        && resource.data.type == request.resource.data.type
        && resource.data.workspaceId == request.resource.data.workspaceId
        && resource.data.numeroNS == request.resource.data.numeroNS
        && resource.data.createdAt == request.resource.data.createdAt
        && (
          sagNsLockOwnerUnchanged()
          || validSagNsLockMetadataRefresh(workspaceId)
          || validSagNsLockOwnerMigration(workspaceId)
        );
    }

    function isSelfPlatformAccount() {
      return isVerifiedUser()
        && resource.data.accountType == 'sector'
        && identityMatchesAccount(resource.data);
    }

    function selfAccountImmutableFieldsPreserved(accountId) {
      return request.resource.data.email == resource.data.email
        && request.resource.data.email == accountId
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.workspaceId == resource.data.workspaceId
        && (
          (
            !('ug' in resource.data)
            && !('ug' in request.resource.data)
          )
          || (
            'ug' in resource.data
            && 'ug' in request.resource.data
            && request.resource.data.ug == resource.data.ug
          )
        )
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function selfAccountWorkspaceIsActive(accountId) {
      return resource.data.workspaceId is string
        && exists(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        )
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.id == resource.data.workspaceId
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
        ).data.authorizedEmail == accountId
        && (
          (
            !('ug' in resource.data)
            && !('ug' in get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data)
          )
          || (
            'ug' in resource.data
            && 'ug' in get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data
            && resource.data.ug == get(
              /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)
            ).data.ug
          )
        );
    }

    function isSelfUidBinding(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && !hasBoundUid(resource.data)
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firstLoginAt is string
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firebaseUid',
          'firstLoginAt',
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isSelfPreboundFirstLogin(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && hasBoundUid(resource.data)
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && !('firstLoginAt' in resource.data)
        && request.resource.data.firstLoginAt is string
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstLoginAt',
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isSelfBoundSessionRefresh(accountId) {
      return isVerifiedUser()
        && isPasswordSectorSession()
        && sectorAccountUsesPasswordProvider(resource.data)
        && resource.data.accountType == 'sector'
        && resource.data.status == 'active'
        && resource.data.email == accountId
        && resource.data.email == request.auth.token.email
        && hasBoundUid(resource.data)
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.firstLoginAt == resource.data.firstLoginAt
        && request.resource.data.lastLoginAt is string
        && request.resource.data.updatedAt is string
        && selfAccountImmutableFieldsPreserved(accountId)
        && selfAccountWorkspaceIsActive(accountId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastLoginAt',
          'updatedAt'
        ]);
    }

    function isValidAuditOperation(operation) {
      return operation in [
        'ns.assign',
        'ns.replace',
        'ns.remove',
        'invoice.identity_migrate',
        'invoice.delete',
        'invoice.bulk_delete',
        'empenho.delete',
        'supplier_cnpj.migrate',
        'sector.create',
        'sector.profile_update',
        'sector.status_change',
        'sector.ug_backfill',
        'sector.password_reset',
        'sector.delete',
        'session.terminate',
        'billing.config_update',
        'billing.trial_grant',
        'billing.status_change',
        'billing.payment_confirm',
        'billing.payment_reopen',
        'historical.repair'
      ];
    }

    function isValidAuditSource(source) {
      return source in ['sag', 'manual', 'migration', 'system', 'admin'];
    }

    function isValidAuditEntityType(entityType) {
      return entityType in [
        'invoice',
        'invoice_batch',
        'empenho',
        'workspace',
        'session',
        'billing_config',
        'billing_account',
        'billing_cycle',
        'ns_lock'
      ];
    }

    function auditUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return (
          workspaceId == 'hgesm-aprov'
          && ug == '160416'
          && (
            !('ug' in workspace)
            || workspace.ug == '160416'
          )
        )
        || (
          ug == null
          && !('ug' in workspace)
        )
        || (
          ug is string
          && 'ug' in workspace
          && workspace.ug == ug
          && isValidUnitUg(ug)
        );
    }

    function validAuditEventShape(eventId, workspaceId) {
      return request.resource.data.keys().hasAll([
          'eventVersion',
          'eventId',
          'workspaceId',
          'ug',
          'operation',
          'source',
          'entityType',
          'entityId',
          'correlationId',
          'actorUid',
          'actorEmail',
          'before',
          'after',
          'metadata',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'eventVersion',
          'eventId',
          'workspaceId',
          'ug',
          'operation',
          'source',
          'entityType',
          'entityId',
          'correlationId',
          'actorUid',
          'actorEmail',
          'before',
          'after',
          'metadata',
          'createdAt'
        ])
        && request.resource.data.eventVersion == 'emprovex_audit_v1'
        && request.resource.data.eventId == eventId
        && request.resource.data.workspaceId == workspaceId
        && isValidAuditOperation(request.resource.data.operation)
        && isValidAuditSource(request.resource.data.source)
        && isValidAuditEntityType(request.resource.data.entityType)
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.correlationId is string
        && request.resource.data.correlationId.size() > 0
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.before is map
        && request.resource.data.after is map
        && request.resource.data.metadata is map
        && request.resource.data.createdAt == request.time;
    }

    function validWorkspaceAuditEvent(eventId, workspaceId) {
      return validAuditEventShape(eventId, workspaceId)
        && auditUgMatchesWorkspace(workspaceId, request.resource.data.ug);
    }

    function validPlatformAuditEvent(eventId) {
      return isPlatformAdmin()
        && validAuditEventShape(
          eventId,
          request.resource.data.workspaceId
        )
        && request.resource.data.source == 'admin'
        && request.resource.data.operation in [
          'sector.create',
          'sector.profile_update',
          'sector.status_change',
          'sector.ug_backfill',
          'sector.password_reset',
          'sector.delete',
          'session.terminate',
          'billing.config_update',
          'billing.trial_grant',
          'billing.status_change',
          'billing.payment_confirm',
          'billing.payment_reopen'
        ];
    }

    function backupUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return isValidUnitUg(ug)
        && (
          (
            workspaceId == 'hgesm-aprov'
            && ug == '160416'
            && (
              !('ug' in workspace)
              || workspace.ug == '160416'
            )
          )
          || (
            'ug' in workspace
            && isValidUnitUg(workspace.ug)
            && workspace.ug == ug
          )
        );
    }

    function validWorkspaceBackupStatus(workspaceId) {
      return canAccessWorkspace(workspaceId)
        && request.resource.data.keys().hasAll([
          'workspaceId',
          'ug',
          'accountEmail',
          'status',
          'lastAttemptAt',
          'lastSuccessAt',
          'latestFileId',
          'latestFileName',
          'sizeBytes',
          'recordCount',
          'schemaVersion',
          'sha256',
          'trigger',
          'lastError',
          'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'workspaceId',
          'ug',
          'accountEmail',
          'status',
          'lastAttemptAt',
          'lastSuccessAt',
          'latestFileId',
          'latestFileName',
          'sizeBytes',
          'recordCount',
          'schemaVersion',
          'sha256',
          'trigger',
          'lastError',
          'updatedBy'
        ])
        && request.resource.data.workspaceId == workspaceId
        && backupUgMatchesWorkspace(workspaceId, request.resource.data.ug)
        && request.resource.data.accountEmail == request.auth.token.email
        && request.resource.data.status in ['success', 'failed', 'in_progress']
        && request.resource.data.lastAttemptAt is string
        && request.resource.data.lastSuccessAt is string
        && request.resource.data.latestFileId is string
        && request.resource.data.latestFileName is string
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes >= 0
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount >= 0
        && request.resource.data.schemaVersion == 1
        && request.resource.data.sha256 is string
        && request.resource.data.trigger in ['automatic', 'manual']
        && request.resource.data.lastError is string
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Diretório administrativo da plataforma. O administrador pode listar e
    // manter metadados, mas não recebe acesso operacional aos workspaces externos.
    match /workspaces/{workspaceId} {
      allow get: if isPlatformAdmin()
        || canReadWorkspaceMetadataFromResource(workspaceId);
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validWorkspaceCreate(workspaceId)
        && workspaceHasMatchingAccountAfterWrite(workspaceId);
      allow update: if isPlatformAdmin()
        && workspaceId != 'hgesm-aprov'
        && validWorkspaceAdminUpdate(workspaceId)
        && workspaceHasMatchingAccountAfterWrite(workspaceId);
      allow delete: if false;
    }

    match /platformAccounts/{accountId} {
      allow get: if isPlatformAdmin() || isSelfPlatformAccount();
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && validSectorAccountCreate(accountId)
        && accountHasMatchingWorkspaceAfterWrite(accountId);
      allow update: if (
          isPlatformAdmin()
          && accountId != 'aprov1hgesm@gmail.com'
          && validSectorAccountAdminUpdate(accountId)
          && accountHasMatchingWorkspaceAfterWrite(accountId)
        )
        || isSelfUidBinding(accountId)
        || isSelfPreboundFirstLogin(accountId)
        || isSelfBoundSessionRefresh(accountId);
      allow delete: if false;
    }

    match /platformAuditEvents/{eventId} {
      allow get, list: if isPlatformAdmin();
      allow create: if validPlatformAuditEvent(eventId);
      allow update, delete: if false;
    }

    match /platformUgIndex/{ug} {
      allow get, list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.keys().hasOnly([
          'ug',
          'workspaceId',
          'email',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.ug == ug
        && isValidUnitUg(ug)
        && request.resource.data.workspaceId is string
        && request.resource.data.email is string
        && existsAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        )
        && existsAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        )
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.ug == ug
        && getAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        ).data.authorizedEmail == request.resource.data.email
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        ).data.ug == ug
        && getAfter(
          /databases/$(database)/documents/platformAccounts/$(request.resource.data.email)
        ).data.workspaceId == request.resource.data.workspaceId;
      allow update, delete: if false;
    }

    // Commercial readiness — metadados de backup. O fundador enxerga apenas
    // saúde/telemetria; o conteúdo operacional continua tenant-scoped.
    match /workspaceBackupStatus/{workspaceId} {
      allow get: if isPlatformAdmin() || canAccessWorkspace(workspaceId);
      allow list: if isPlatformAdmin();
      allow create, update: if validWorkspaceBackupStatus(workspaceId);
      allow delete: if false;
    }

    // Metadados do backup global de identidade. Nunca contém hashes/senhas.
    match /platformRecoveryStatus/{id} {
      allow get, list, create, update: if isPlatformAdmin();
      allow delete: if false;
    }

    // Block 16.2 — collection-group read used only by the founder dashboard.
    // This recursive match grants no writes and no access to external sectors.
    match /{path=**}/sessionSlots/{slotId} {
      allow get, list: if isPlatformAdmin();
    }

    // Block 16.2 — collection-group queries require a recursive match. This
    // grants only global LIST to the platform admin; no create/update/delete
    // permission is introduced here and sector users receive no access.
    match /{sessionSlotPath=**}/sessionSlots/{slotId} {
      allow list: if isPlatformAdmin();
    }

    // Block 16.1 — capacity metadata. These two fixed slots enforce a maximum of
    // two simultaneous external-sector browser sessions without query/count races.
    // The founder is exempt and never claims a slot.
    match /workspaces/{workspaceId}/sessionSlots/{slotId} {
      allow get, list: if canAccessWorkspace(workspaceId) || isPlatformAdmin();
      allow create: if validWorkspaceSessionLeaseCreate(workspaceId, slotId);
      allow update: if validWorkspaceSessionLeaseUpdate(workspaceId, slotId);
      allow delete: if validWorkspaceSessionLeaseDelete(workspaceId, slotId)
        || validAdminSessionSlotDelete(workspaceId, slotId);
    }

    // Block 16.2 — tombstones curtos impedem uma sessão encerrada remotamente
    // de recriar o slot com o mesmo sessionId.
    match /workspaces/{workspaceId}/sessionRevocations/{sessionId} {
      // O cliente precisa poder consultar um sessionId que normalmente ainda não
      // existe. Por isso o GET é tenant-scoped pelo workspace, sem depender de
      // resource.data; LIST continua exclusivo da administração.
      allow get: if isPlatformAdmin() || canAccessWorkspace(workspaceId);
      allow list: if isPlatformAdmin();
      allow create: if validSessionRevocationCreate(workspaceId, sessionId);
      allow update, delete: if false;
    }

    // Histórico global de cota/faturamento: escrito exclusivamente pelo servidor
    // via IAM e somente legível pela conta fundadora. Clientes jamais podem forjar
    // a série histórica usada nos relatórios administrativos.
    match /platformUsageHistory/{dayKey} {
      allow get, list: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // Block 16.3 — low-frequency workspace usage estimates. Sector clients can
    // only append monotonically to their own UG counters; only the founder can read.
    match /workspaces/{workspaceId}/usageEstimates/{dayKey} {
      allow get, list: if isPlatformAdmin();
      allow create: if validWorkspaceUsageEstimateCreate(workspaceId, dayKey);
      allow update: if validWorkspaceUsageEstimateUpdate(workspaceId, dayKey);
      allow delete: if false;
    }

    function validHomeSnapshotNumber(value) {
      return value is number && value >= 0;
    }

    function homeSnapshotUgMatchesWorkspace(workspaceId, ug) {
      let workspace = workspaceData(workspaceId);
      return isValidUnitUg(ug)
        && (
          (
            workspaceId == 'hgesm-aprov'
            && ug == '160416'
            && (
              !('ug' in workspace)
              || workspace.ug == '160416'
            )
          )
          || (
            'ug' in workspace
            && isValidUnitUg(workspace.ug)
            && workspace.ug == ug
          )
        );
    }

    function validHomeSnapshot(workspaceId) {
      return canAccessWorkspace(workspaceId)
        && request.resource.data.keys().hasAll([
          'snapshotVersion',
          'workspaceId',
          'ug',
          'contentHash',
          'generatedAt',
          'generatedBy',
          'metrics',
          'alerts',
          'receiving',
          'execution',
          'classStats',
          'stars'
        ])
        && request.resource.data.keys().hasOnly([
          'snapshotVersion',
          'workspaceId',
          'ug',
          'contentHash',
          'generatedAt',
          'generatedBy',
          'metrics',
          'alerts',
          'receiving',
          'execution',
          'classStats',
          'stars'
        ])
        && request.resource.data.snapshotVersion == 'emprovex_home_snapshot_v1'
        && request.resource.data.workspaceId == workspaceId
        && homeSnapshotUgMatchesWorkspace(workspaceId, request.resource.data.ug)
        && request.resource.data.contentHash is string
        && request.resource.data.contentHash.matches('^[0-9a-f]{8}$')
        && request.resource.data.generatedAt is string
        && request.resource.data.generatedAt.size() > 10
        && request.resource.data.generatedBy == request.auth.uid
        && request.resource.data.metrics is map
        && request.resource.data.metrics.keys().hasOnly([
          'totalEmpenhos',
          'totalValue'
        ])
        && validHomeSnapshotNumber(request.resource.data.metrics.totalEmpenhos)
        && validHomeSnapshotNumber(request.resource.data.metrics.totalValue)
        && request.resource.data.alerts is map
        && request.resource.data.alerts.keys().hasOnly([
          'total',
          'critical',
          'attention'
        ])
        && validHomeSnapshotNumber(request.resource.data.alerts.total)
        && validHomeSnapshotNumber(request.resource.data.alerts.critical)
        && validHomeSnapshotNumber(request.resource.data.alerts.attention)
        && request.resource.data.receiving is map
        && request.resource.data.receiving.keys().hasOnly([
          'pendingEmpenhos',
          'pendingItems',
          'balance'
        ])
        && validHomeSnapshotNumber(request.resource.data.receiving.pendingEmpenhos)
        && validHomeSnapshotNumber(request.resource.data.receiving.pendingItems)
        && validHomeSnapshotNumber(request.resource.data.receiving.balance)
        && request.resource.data.execution is map
        && request.resource.data.execution.keys().hasOnly([
          'committed',
          'received',
          'percentage'
        ])
        && validHomeSnapshotNumber(request.resource.data.execution.committed)
        && validHomeSnapshotNumber(request.resource.data.execution.received)
        && validHomeSnapshotNumber(request.resource.data.execution.percentage)
        && request.resource.data.execution.percentage <= 100
        && request.resource.data.classStats is list
        && request.resource.data.classStats.size() <= 32
        && request.resource.data.stars is list
        && request.resource.data.stars.size() <= 72;
    }

    // Workspace-scoped operational data. There is deliberately no admin bypass:
    // a platform administrator cannot read another sector's operational records.
    match /workspaces/{workspaceId}/auditEvents/{eventId} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validWorkspaceAuditEvent(eventId, workspaceId);
      allow update, delete: if false;
    }

    match /workspaces/{workspaceId}/empenhos/{id} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validEmpenhoRevisionCreate(request.resource.data)
        && empenhoCnpjCreateIsValid(request.resource.data);
      allow update: if canAccessWorkspace(workspaceId)
        && !empenhoDeletionIsLockedAfter(workspaceId, id)
        && validEmpenhoRevisionUpdate()
        && empenhoCnpjUpdateIsValid();
      allow delete: if canAccessWorkspace(workspaceId)
        && validEmpenhoLifecycleDelete(workspaceId, id);
    }

    match /workspaces/{workspaceId}/alerts/{id} {
      allow read, delete: if canAccessWorkspace(workspaceId);
      allow create, update: if canAccessWorkspace(workspaceId)
        && linkedEmpenhoWriteAllowedAfter(workspaceId, request.resource.data);
    }

    match /workspaces/{workspaceId}/invoices/{id} {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validInvoiceCreate(workspaceId, id);
      allow update: if canAccessWorkspace(workspaceId)
        && validInvoiceUpdate(workspaceId, id);
      allow delete: if canAccessWorkspace(workspaceId)
        && validInvoiceDelete(workspaceId, id);
    }

    match /workspaces/{workspaceId}/comissoes/{id} {
      allow read, write: if canAccessWorkspace(workspaceId);
    }

    match /workspaces/{workspaceId}/cronogramas/{id} {
      allow read, delete: if canAccessWorkspace(workspaceId);
      allow create, update: if canAccessWorkspace(workspaceId)
        && linkedEmpenhoWriteAllowedAfter(workspaceId, request.resource.data);
    }

    // Block 19.10 — snapshot econômico do Início.
    // Um único documento derivado alimenta a Home; ele não concede autorização
    // e nunca substitui as coleções operacionais como fonte de verdade.
    match /workspaces/{workspaceId}/settings/homeSnapshot {
      allow read: if canAccessWorkspace(workspaceId);
      allow create, update: if validHomeSnapshot(workspaceId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/termoRecebimentoCounter {
      // O cadastro administrativo verifica se existe contador residual antes de
      // provisionar um workspace novo. Essa leitura prévia só é permitida enquanto
      // o workspace ainda não existe; depois da criação, o administrador volta a
      // não possuir acesso ao contador operacional do tenant.
      allow read: if canAccessWorkspace(workspaceId)
        || (
          isPlatformAdmin()
          && !workspaceExists(workspaceId)
        );
      allow create: if canAdminProvisionTermCounter(workspaceId)
        || (
          canAccessWorkspace(workspaceId)
          && validInitialTermCounter()
        );
      allow update: if canAccessWorkspace(workspaceId)
        && validOperationalTermCounterUpdate();
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/documentStorage {
      allow read: if canAccessWorkspace(workspaceId);
      allow create: if canAccessWorkspace(workspaceId)
        && validWorkspaceDocumentStorage(workspaceId);
      allow update: if canAccessWorkspace(workspaceId)
        && validWorkspaceDocumentStorageUpdate(workspaceId);
      allow delete: if false;
    }

    match /workspaces/{workspaceId}/settings/{id} {
      // Listagem é limitada ao próprio workspace autenticado. Os settings atuais
      // já são individualmente legíveis pelo setor; o list habilita diagnósticos
      // de integridade sem ampliar acesso entre tenants.
      allow list: if canAccessWorkspace(workspaceId);
      allow get: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId);
      allow create: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && (
          (
            isEmpenhoDeletionLockId(id)
            && validEmpenhoDeletionLockCreate(workspaceId, id)
          )
          || (
            !isEmpenhoDeletionLockId(id)
            && (
              !isSagNsLockId(id)
              || validSagNsLock(workspaceId, id)
            )
          )
        );
      allow update: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && !isEmpenhoDeletionLockId(id)
        && (
          !isSagNsLockId(id)
          || validSagNsLockUpdate(workspaceId, id)
        );
      allow delete: if id != 'termoRecebimentoCounter'
        && id != 'documentStorage'
        && id != 'homeSnapshot'
        && canAccessWorkspace(workspaceId)
        && (
          (
            isEmpenhoDeletionLockId(id)
            && validEmpenhoDeletionLockDelete(workspaceId, id)
          )
          || (
            !isEmpenhoDeletionLockId(id)
            && (
              !isSagNsLockId(id)
              || validSagNsLockDelete(workspaceId, id)
            )
          )
        );
    }

    // Bloco 13 — compatibilidade legada somente leitura.
    // O runtime oficial já usa /workspaces/hgesm-aprov/...; os dados raiz ficam
    // preservados apenas para consulta, auditoria e recuperação controlada.
    // Qualquer rollback com escrita exige mudança explícita de Rules, evitando que
    // uma simples regressão de frontend volte silenciosamente a gravar no legado.
    match /empenhos/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /alerts/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /invoices/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /comissoes/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    match /cronogramas/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }

    // A identidade visual global precisa continuar disponível antes do login.
    // A marca institucional é imutável no runtime: qualquer troca futura exige
    // manutenção deliberada fora da aplicação e revisão explícita destas Rules.
    match /settings/global {
      allow read: if true;
      allow write: if false;
    }

    // Demais settings raiz (incluindo o contador histórico) ficam somente leitura.
    match /settings/{id} {
      allow read: if isHgesmFounder();
      allow write: if false;
    }
  }
}
