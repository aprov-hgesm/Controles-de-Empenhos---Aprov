{
  "hosting": {
    "site": "emprovex-cloudrun-943599311487",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "emprovex-cloudrun-candidate",
          "region": "southamerica-east1"
        }
      }
    ],
    "headers": [
      {
        "source": "/central-empenhos",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private, no-store, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
