# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Produção: APP_URL=https://emprovex.com.br no Cloud Run.
# A URL .run.app não é a origem pública; Firebase Hosting encerra HTTPS.
# Usada para links absolutos, callbacks e referências de API.
APP_URL="MY_APP_URL"


# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON: FALLBACK LEGADO apenas fora do Cloud Run
# (Vercel em contingência / desenvolvimento). No Cloud Run a conta de serviço
# anexada à revisão obtém OAuth2 via metadata server, sem arquivo JSON.
# A devolução/cancelamento de saída do ADM Depósito não depende desta credencial;
# ela usa o motor transacional protegido pelas Firestore Rules no warehouseDb.
# Nunca usar prefixo NEXT_PUBLIC_ e nunca expor este valor ao navegador.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=""

# Kill switch opcional da SAAS-DS. Quando = "1", bloqueia somente novas
# suspensões/reativações administrativas, sem alterar o estado já materializado.
EMPROVEX_DISABLE_SECTOR_LIFECYCLE="0"

# Cloud Monitoring: no Cloud Run usar identidade da revisão e roles/monitoring.viewer.
# Credenciais por chave permanecem como fallback legado somente fora do Cloud Run.
EMPROVEX_GCP_MONITORING_CLIENT_EMAIL=""
EMPROVEX_GCP_MONITORING_PRIVATE_KEY=""

# Firestore Enterprise — referência administrativa da franquia até cobrança.
# O banco de produção atual foi verificado como elegível ao free tier.
# Os defaults do código são 50.000 Read Units/dia, 50.000 Realtime Read Units/dia
# e 40.000 Write Units/dia. Estas variáveis permitem alterar a referência sem deploy.
EMPROVEX_FIRESTORE_FREE_TIER_ELIGIBLE="true"
EMPROVEX_FIRESTORE_DAILY_READ_UNIT_FREE_LIMIT="50000"
EMPROVEX_FIRESTORE_DAILY_REALTIME_READ_UNIT_FREE_LIMIT="50000"
EMPROVEX_FIRESTORE_DAILY_WRITE_UNIT_FREE_LIMIT="40000"


# Protege a rota diária de consolidação do histórico de consumo.
# Cron NÃO migrado para Cloud Scheduler em 31/10/2026.
# A listagem Production Vercel não continha CRON_SECRET; não presumir execução.
# Para ativar o cron, implantar UM agendamento autenticado e segredo gerenciado.
CRON_SECRET=""

# Compartilhamento financeiro opcional, sem alteração de contas, acessos ou workspaces.
# Habilitar somente após validação das transações e do texto contratual.
EMPROVEX_SHARED_BILLING_ENABLED="0"
