# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON: credencial server-only usada pelas rotas
# administrativas e, quando disponível, também pelo leitor do Cloud Monitoring.
# Nunca usar prefixo NEXT_PUBLIC_ e nunca expor este valor ao navegador.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=""

# Cloud Monitoring: as credenciais dedicadas continuam aceitas como fallback.
# Se FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON já estiver configurada com permissão de
# leitura do Monitoring, não é necessário manter uma segunda chave privada.
EMPROVEX_GCP_MONITORING_CLIENT_EMAIL=""
EMPROVEX_GCP_MONITORING_PRIVATE_KEY=""

# Firestore Enterprise — referência administrativa da franquia até cobrança.
# O banco de produção atual foi verificado como elegível ao free tier.
# Os defaults do código são 50.000 Read Units/dia, 50.000 Realtime Read Units/dia
# e 40.000 Write Units/dia. Estas variáveis permitem alterar a referência sem deploy.
EMPROVEX_FIRESTORE_FREE_TIER_ELIGIBLE="true"
EMPROVEX_FIRESTORE_DAILY_READ_UNIT_FREE_LIMIT="50000"
EMPROVEX_FIRESTORE_DAILY_REALTIME_READ_UNIT_FREE_LIMIT="50000"
EMPROVEX_FIRESTORE_DAILY_WRITE_UNIT_FREE_LIMIT="40000"
