# W8 Cloud Run QA packaging — intentionally NOT a deployment.
# Requires an actual Firebase Web App created in the QA project.
# W4 instrumentation startup interlock remains in force; image must NOT be deployed
# until explicit R01/R02/R04 certification and separate approval.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
ARG QA_FIREBASE_WEB_CONFIG_JSON
ENV EMPROVEX_RUNTIME_TARGET=cloud-run-staging \
    EMPROVEX_CLOUD_PROJECT_ID=emprovex-qa-r1-261015-6275 \
    EMPROVEX_CLOUD_CORE_DATABASE_ID=qa-core \
    EMPROVEX_CLOUD_WAREHOUSE_DATABASE_ID=qa-warehouse \
    NEXT_PUBLIC_EMPROVEX_FIREBASE_CONFIG_JSON=${QA_FIREBASE_WEB_CONFIG_JSON}
# next.config.ts runs the W4 SOURCE isolation gate. This additionally scans the
# finished output for production Firebase references. Never disable either gate.
RUN test -n "$QA_FIREBASE_WEB_CONFIG_JSON" \
 && npm run build \
 && node scripts/cloud-run-qa-artifact-audit.mjs

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    EMPROVEX_RUNTIME_TARGET=cloud-run-staging
RUN addgroup --system --gid 1001 nextjs \
 && adduser --system --uid 1001 --ingroup nextjs nextjs
COPY --from=builder --chown=nextjs:nextjs /app/public ./public
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static ./.next/static
USER nextjs
EXPOSE 8080
# The existing W4 instrumentation lock intentionally blocks Cloud Run start.
CMD ["node", "server.js"]
